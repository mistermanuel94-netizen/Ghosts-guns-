---
import { getLocalizedPath, useTranslations, type Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="border-l border-r border-b border-[#e5e5e5] bg-white py-12 px-4 md:px-8">
  <div class="max-w-6xl mx-auto">
    <!-- Header Block -->
    <div class="border-b border-black pb-6 mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <p class="text-xs font-mono uppercase text-[#9f0712] font-bold tracking-widest mb-2">
          {t('nichePillar.tag')}
        </p>
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-heading font-black uppercase text-black leading-tight max-w-3xl">
          {t('nichePillar.title')}
        </h2>
      </div>
      <a
        href={getLocalizedPath('/shop/', lang)}
        class="inline-flex items-center gap-2 self-start md:self-end px-5 py-2.5 bg-black hover:bg-neutral-800 text-white font-mono text-xs uppercase font-bold tracking-wider transition-colors shrink-0"
      >
        <span>{t('nichePillar.explorePillar')}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      </a>
    </div>

    <!-- Intro Lead Paragraph -->
    <p class="text-sm md:text-base font-sans text-neutral-700 leading-relaxed max-w-4xl mb-10">
      {t('nichePillar.intro')}
    </p>

    <!-- 4 Pillar Feature Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Card 1: CoreXY 3D Printers -->
      <div class="border border-[#e5e5e5] p-5 flex flex-col justify-between hover:border-black transition-colors bg-neutral-50/40">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[10px] font-mono font-bold bg-black text-white px-2 py-0.5 uppercase">01 // PLATFORM</span>
            <span class="w-2 h-2 bg-[#9f0712]"></span>
          </div>
          <h3 class="text-base font-heading font-black uppercase text-black mb-3 leading-snug">
            {t('nichePillar.card1Title')}
          </h3>
          <p class="text-xs text-neutral-600 leading-relaxed font-sans mb-4">
            {t('nichePillar.card1Text')}
          </p>
        </div>
        <a
          href={getLocalizedPath('/3d-printers/', lang)}
          class="text-xs font-mono font-bold text-[#9f0712] hover:text-black uppercase underline flex items-center gap-1 mt-2"
        >
          {t('nav.threeDPrinters')} &rarr;
        </a>
      </div>

      <!-- Card 2: Engineering Filaments -->
      <div class="border border-[#e5e5e5] p-5 flex flex-col justify-between hover:border-black transition-colors bg-neutral-50/40">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[10px] font-mono font-bold bg-black text-white px-2 py-0.5 uppercase">02 // MATERIALS</span>
            <span class="w-2 h-2 bg-[#9f0712]"></span>
          </div>
          <h3 class="text-base font-heading font-black uppercase text-black mb-3 leading-snug">
            {t('nichePillar.card2Title')}
          </h3>
          <p class="text-xs text-neutral-600 leading-relaxed font-sans mb-4">
            {t('nichePillar.card2Text')}
          </p>
        </div>
        <a
          href={getLocalizedPath('/3d-printing/', lang)}
          class="text-xs font-mono font-bold text-[#9f0712] hover:text-black uppercase underline flex items-center gap-1 mt-2"
        >
          {t('nav.threeDPrinting')} &rarr;
        </a>
      </div>

      <!-- Card 3: Router Jigs & 80% Receivers -->
      <div class="border border-[#e5e5e5] p-5 flex flex-col justify-between hover:border-black transition-colors bg-neutral-50/40">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[10px] font-mono font-bold bg-black text-white px-2 py-0.5 uppercase">03 // MACHINING</span>
            <span class="w-2 h-2 bg-[#9f0712]"></span>
          </div>
          <h3 class="text-base font-heading font-black uppercase text-black mb-3 leading-snug">
            {t('nichePillar.card3Title')}
          </h3>
          <p class="text-xs text-neutral-600 leading-relaxed font-sans mb-4">
            {t('nichePillar.card3Text')}
          </p>
        </div>
        <a
          href={getLocalizedPath('/80-firearm/', lang)}
          class="text-xs font-mono font-bold text-[#9f0712] hover:text-black uppercase underline flex items-center gap-1 mt-2"
        >
          {t('nav.eightyPercent')} &rarr;
        </a>
      </div>

      <!-- Card 4: Steel Slides & Locking Rails -->
      <div class="border border-[#e5e5e5] p-5 flex flex-col justify-between hover:border-black transition-colors bg-neutral-50/40">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[10px] font-mono font-bold bg-black text-white px-2 py-0.5 uppercase">04 // HARDWARE</span>
            <span class="w-2 h-2 bg-[#9f0712]"></span>
          </div>
          <h3 class="text-base font-heading font-black uppercase text-black mb-3 leading-snug">
            {t('nichePillar.card4Title')}
          </h3>
          <p class="text-xs text-neutral-600 leading-relaxed font-sans mb-4">
            {t('nichePillar.card4Text')}
          </p>
        </div>
        <a
          href={getLocalizedPath('/component/slide/', lang)}
          class="text-xs font-mono font-bold text-[#9f0712] hover:text-black uppercase underline flex items-center gap-1 mt-2"
        >
          {t('nav.slides')} &rarr;
        </a>
      </div>
    </div>
  </div>
</section>
