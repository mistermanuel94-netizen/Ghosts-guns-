---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import { useTranslations, getLocalizedPath, type Locale } from '../utils/i18n';
import { SILO_PILLARS, getCategoryProductCount } from '../utils/silo';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const allProducts = products;
---

<Layout
  title={`${t('catalog.shopCatalog')} | Ghost Guns`}
  description={t('shopHero.subtitle')}
  lang={lang}
>
  <div class="max-w-[1440px] mx-auto bg-white shadow-sm">
    <!-- 1. Master Shop & Silo Directory Hero Section -->
    <div class="relative bg-neutral-950 text-white border-l border-r border-b border-neutral-300 overflow-hidden bg-blueprint-grid">
      <div
        class="absolute inset-0 bg-cover bg-center opacity-20 mix-blend-luminosity filter contrast-125 pointer-events-none"
        style="background-image: url('/assets/images/hero-bg.webp');"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/85 to-transparent pointer-events-none"></div>

      <div class="relative z-10 px-4 sm:px-8 py-10 sm:py-14 max-w-6xl mx-auto">
        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="text-[11px] font-mono uppercase text-neutral-400 flex items-center gap-2 mb-5 pb-4 border-b border-neutral-800">
          <a href={getLocalizedPath('/', lang)} class="hover:text-white transition-colors">{t('product.home')}</a>
          <span class="text-neutral-600">/</span>
          <span class="text-white font-bold bg-white/10 px-2 py-0.5">{t('catalog.shopCatalog')} (76 ITEMS)</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
          <div class="lg:col-span-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#9f0712]/25 border border-[#9f0712] text-[#ff4d58] text-xs font-mono uppercase tracking-widest font-bold mb-3">
              <span class="w-1.5 h-1.5 bg-[#9f0712] rounded-full animate-pulse"></span>
              <span>{t('shopHero.tag')}</span>
            </div>

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black uppercase text-white font-heading tracking-tight leading-none mb-3">
              {t('shopHero.title')}
            </h1>

            <p class="text-xs sm:text-sm md:text-base text-neutral-300 font-sans leading-relaxed max-w-3xl m-0">
              {t('shopHero.subtitle')}
            </p>
          </div>

          <div class="lg:col-span-4 grid grid-cols-3 gap-2 text-center">
            <div class="p-3 bg-neutral-900/90 border border-neutral-800">
              <span class="block text-xl sm:text-2xl font-black text-white font-mono leading-none mb-1">{allProducts.length}</span>
              <span class="block text-[9px] sm:text-[10px] font-mono uppercase text-neutral-400">{t('shopHero.statPlatforms')}</span>
            </div>
            <div class="p-3 bg-neutral-900/90 border border-neutral-800">
              <span class="block text-xl sm:text-2xl font-black text-[#ff4d58] font-mono leading-none mb-1">100%</span>
              <span class="block text-[9px] sm:text-[10px] font-mono uppercase text-neutral-400">{t('shopHero.statShipping')}</span>
            </div>
            <div class="p-3 bg-neutral-900/90 border border-neutral-800">
              <span class="block text-xl sm:text-2xl font-black text-white font-mono leading-none mb-1">€ EUR</span>
              <span class="block text-[9px] sm:text-[10px] font-mono uppercase text-neutral-400">{t('shopHero.statCurrency')}</span>
            </div>
          </div>
        </div>

        <!-- 5-Pillar Silo Architecture Quick-Cards -->
        <div class="mt-8 pt-6 border-t border-neutral-800 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
          {SILO_PILLARS.map((pillar) => {
            const count = getCategoryProductCount(pillar.slug, pillar.spokes.map(s => s.slug));
            return (
              <a
                href={getLocalizedPath(pillar.path, lang)}
                class="p-3 bg-neutral-900/80 hover:bg-[#9f0712] border border-neutral-800 hover:border-[#9f0712] transition-all flex flex-col justify-between group"
              >
                <div class="flex items-center justify-between gap-1 mb-1">
                  <span class="text-[9px] font-mono font-bold text-[#ff4d58] group-hover:text-white uppercase">
                    {pillar.code.split('//')[0].trim()}
                  </span>
                  <span class="text-[10px] font-mono font-bold text-neutral-300 group-hover:text-white">({count})</span>
                </div>
                <span class="text-xs font-heading font-bold uppercase text-white leading-tight block">
                  {pillar.defaultTitle}
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- 2. Sticky Filter, Search & Sort Toolbar -->
    <div class="sticky top-[52px] lg:top-[94px] z-40 bg-white border-l border-r border-b border-neutral-300 px-4 sm:px-6 py-3.5 shadow-xs">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <!-- Left: Silo Filter Chips -->
        <div class="w-full lg:w-auto overflow-hidden">
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar whitespace-nowrap py-0.5 text-xs font-mono">
            <a
              href={getLocalizedPath('/shop/', lang)}
              class="px-3 py-1.5 bg-neutral-950 text-white border border-neutral-950 uppercase font-bold text-[11px] shrink-0"
            >
              ALL ({allProducts.length})
            </a>
            <a
              href={getLocalizedPath('/3d-printers/', lang)}
              class="px-3 py-1.5 bg-white border border-[#9f0712] text-[#9f0712] font-bold hover:bg-[#9f0712] hover:text-white uppercase transition-colors text-[11px] shrink-0 flex items-center gap-1"
            >
              <span>{t('catalog.filter3DPrinters')}</span>
              <span class="text-[9px] bg-[#9f0712] text-white px-1 py-0.2 font-bold">SILO 01</span>
            </a>
            <a
              href={getLocalizedPath('/build-kit/', lang)}
              class="px-3 py-1.5 bg-white border border-neutral-300 hover:border-neutral-950 uppercase text-[11px] text-neutral-900 font-bold shrink-0"
            >
              {t('catalog.filterBuildKits')}
            </a>
            <a
              href={getLocalizedPath('/80-firearm/', lang)}
              class="px-3 py-1.5 bg-white border border-neutral-300 hover:border-neutral-950 uppercase text-[11px] text-neutral-900 font-bold shrink-0"
            >
              {t('catalog.filter80Percent')}
            </a>
            <a
              href={getLocalizedPath('/component/', lang)}
              class="px-3 py-1.5 bg-white border border-neutral-300 hover:border-neutral-950 uppercase text-[11px] text-neutral-900 font-bold shrink-0"
            >
              {t('catalog.filterParts')}
            </a>
            <a
              href={getLocalizedPath('/3d-printing/', lang)}
              class="px-3 py-1.5 bg-white border border-neutral-300 hover:border-neutral-950 uppercase text-[11px] text-neutral-900 font-bold shrink-0"
            >
              {t('catalog.filter3DPrinting')}
            </a>
            <a
              href={getLocalizedPath('/magazines/', lang)}
              class="px-3 py-1.5 bg-white border border-neutral-300 hover:border-neutral-950 uppercase text-[11px] text-neutral-900 font-bold shrink-0"
            >
              Magazines
            </a>
          </div>
        </div>

        <!-- Right: Live Search Filter + Sort Selector -->
        <div class="flex flex-wrap items-center justify-between lg:justify-end gap-3 shrink-0 pt-2.5 lg:pt-0 border-t lg:border-t-0 border-neutral-200">
          <div class="relative flex-1 sm:flex-initial sm:w-56">
            <input
              type="search"
              id="shop-live-filter"
              placeholder="SEARCH 76 PLATFORMS..."
              class="w-full h-[36px] px-3 text-xs font-mono uppercase bg-neutral-50 border border-neutral-300 focus:border-neutral-950 focus:bg-white focus:outline-none text-neutral-950"
            />
          </div>

          <p id="shop-item-count" class="text-[11px] sm:text-xs font-mono text-neutral-500 uppercase whitespace-nowrap m-0 hidden sm:block">
            {t('catalog.showingAll').replace('{count}', allProducts.length.toString())}
          </p>

          <div class="flex items-center gap-2">
            <label for="shop-sort-select" class="hidden xl:inline text-xs font-mono uppercase font-bold text-neutral-600 whitespace-nowrap">
              {t('catalog.sortLabel')}
            </label>
            <div class="relative min-w-[165px]">
              <select
                id="shop-sort-select"
                class="w-full h-[36px] pl-3 pr-8 text-xs font-mono font-bold uppercase bg-white border border-neutral-300 hover:border-neutral-950 focus:outline-none focus:border-neutral-950 rounded-none appearance-none cursor-pointer transition-colors text-neutral-950"
                aria-label={t('catalog.sortLabel')}
              >
                <option value="default">{t('catalog.sortDefault')}</option>
                <option value="popularity">{t('catalog.sortPopularity')}</option>
                <option value="date">{t('catalog.sortLatest')}</option>
                <option value="price-asc">{t('catalog.sortPriceAsc')}</option>
                <option value="price-desc">{t('catalog.sortPriceDesc')}</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-neutral-950">
                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Products Grid -->
    <ul id="shop-products-grid" class="products list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 border-l border-t border-neutral-300 transition-opacity duration-200">
      {allProducts.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </ul>
  </div>
</Layout>

<script>
  function initShopControls() {
    const sortSelect = document.getElementById('shop-sort-select') as HTMLSelectElement | null;
    const filterInput = document.getElementById('shop-live-filter') as HTMLInputElement | null;
    const productsGrid = document.getElementById('shop-products-grid');
    const countLabel = document.getElementById('shop-item-count');

    if (!productsGrid) return;
    const initialItems = Array.from(productsGrid.children) as HTMLElement[];

    function updateGrid() {
      const criteria = sortSelect?.value || 'default';
      const query = (filterInput?.value || '').trim().toLowerCase();

      let sorted = [...initialItems];
      if (criteria === 'price-asc') {
        sorted.sort((a, b) => parseFloat(a.getAttribute('data-price') || '0') - parseFloat(b.getAttribute('data-price') || '0'));
      } else if (criteria === 'price-desc') {
        sorted.sort((a, b) => parseFloat(b.getAttribute('data-price') || '0') - parseFloat(a.getAttribute('data-price') || '0'));
      } else if (criteria === 'popularity') {
        sorted.sort((a, b) => parseInt(b.getAttribute('data-popularity') || '0', 10) - parseInt(a.getAttribute('data-popularity') || '0', 10));
      } else if (criteria === 'date') {
        sorted.sort((a, b) => parseInt(b.getAttribute('data-id') || '0', 10) - parseInt(a.getAttribute('data-id') || '0', 10));
      }

      let visibleCount = 0;
      sorted.forEach((el) => {
        const name = (el.getAttribute('data-name') || '').toLowerCase();
        const silo = (el.getAttribute('data-silo') || '').toLowerCase();
        const matches = !query || name.includes(query) || silo.includes(query);
        el.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
        productsGrid.appendChild(el);
      });

      if (countLabel) {
        countLabel.textContent = `SHOWING ${visibleCount} OF ${initialItems.length} ITEMS`;
      }
    }

    const currentParams = new URLSearchParams(window.location.search);
    const initialOrderby = currentParams.get('orderby');
    const initialSearch = currentParams.get('s');

    if (filterInput && initialSearch) {
      filterInput.value = initialSearch;
    }

    if (sortSelect && initialOrderby && ['popularity', 'date', 'price-asc', 'price-desc'].includes(initialOrderby)) {
      sortSelect.value = initialOrderby;
    }

    if (initialOrderby || initialSearch) {
      updateGrid();
    }

    sortSelect?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      updateGrid();
      const url = new URL(window.location.href);
      if (val === 'default') {
        url.searchParams.delete('orderby');
      } else {
        url.searchParams.set('orderby', val);
      }
      window.history.replaceState({}, '', url.toString());
    });

    filterInput?.addEventListener('input', updateGrid);
  }

  initShopControls();
  document.addEventListener('astro:page-load', initShopControls);
</script>
