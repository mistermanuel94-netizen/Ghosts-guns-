---
import PolicyView from '../../views/PolicyView.astro';
import { LOCALES, type Locale } from '../../utils/i18n';

export function getStaticPaths() {
  return LOCALES.filter(l => l !== 'en').map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---

<PolicyView slug="privacy-policy" lang={lang as Locale} />
