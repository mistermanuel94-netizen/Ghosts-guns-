---
import BlogIndexView from '../../../views/BlogIndexView.astro';
import { LOCALES, type Locale } from '../../../utils/i18n';

export function getStaticPaths() {
  return LOCALES.filter(l => l !== 'en').map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---

<BlogIndexView lang={lang as Locale} />
