---
import { LOCALES, LANGUAGES, getLocalizedPath, type Locale } from '../utils/i18n';

interface Props {
  currentLang?: Locale;
  currentPath?: string;
}

const { currentLang = 'en', currentPath = Astro.url.pathname } = Astro.props;
---

<div class="lang-bar w-full bg-[#111] text-white text-[11px] font-mono border-b border-[#222]">
  <div class="lg:container lg:mx-auto flex flex-wrap items-center justify-between px-3 py-1.5 gap-2">
    <!-- Notice / Promo -->
    <div class="hidden sm:flex items-center gap-2 text-neutral-400">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="uppercase tracking-wider">ALL ORDERS SHIPPED DISCREETLY // CURRENCY: EURO (€)</span>
    </div>

    <!-- Language Selector List -->
    <div class="flex items-center flex-wrap gap-1 md:gap-1.5 ml-auto" id="language-switcher-list">
      <span class="text-neutral-400 uppercase text-[10px] mr-1 hidden lg:inline">LANGUAGE:</span>
      {LOCALES.map((loc) => {
        const langMeta = LANGUAGES[loc];
        const targetUrl = getLocalizedPath(currentPath, loc);
        const isActive = loc === currentLang;
        return (
          <a
            href={targetUrl}
            class={`lang-chip px-2 py-0.5 rounded-none flex items-center gap-1 transition-all ${
              isActive
                ? 'bg-white text-black font-bold border border-white shadow-sm'
                : 'text-neutral-300 hover:text-white hover:bg-neutral-800 border border-transparent'
            }`}
            title={langMeta.name}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="flag-icon text-xs leading-none">{langMeta.flag}</span>
            <span class="uppercase tracking-wider">{loc.toUpperCase()}</span>
          </a>
        );
      })}
    </div>
  </div>
</div>

<style>
  .lang-bar {
    position: relative;
    z-index: 60;
  }
  .lang-chip {
    text-decoration: none;
    cursor: pointer;
    font-size: 11px;
    line-height: 1.2;
  }
  .lang-chip:hover {
    text-decoration: none;
  }
</style>
