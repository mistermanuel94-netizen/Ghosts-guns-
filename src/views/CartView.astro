---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath, type Locale } from '../utils/i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  title={`${t('cart.yourCart')} | Ghost Guns`}
  description="Review your Ghost Guns shopping cart and proceed to checkout."
  lang={lang}
>
  <div class="lg:container lg:mx-auto">
    <!-- Header banner -->
    <div class="border-[#e5e5e5] border-r border-l border-t border-b px-4 py-6 bg-neutral-50 flex items-center gap-2">
      <h1 class="uppercase font-black text-black text-2xl md:text-3xl m-0 leading-none font-heading">{t('cart.yourCart')}</h1>
      <div class="w-[12px] h-[24px] bg-black"></div>
    </div>

    <!-- Cart Layout -->
    <div class="border-l border-r border-b border-[#e5e5e5] p-6 md:p-10 font-mono" data-lang={lang}>
      <div id="full-cart-empty" class="text-center py-16 hidden">
        <p class="text-neutral-500 mb-6 text-sm">{t('cart.emptyCart')}</p>
        <a href={getLocalizedPath('/shop/', lang)} class="inline-block px-8 py-3 bg-black text-white font-bold uppercase text-xs tracking-wider hover:bg-neutral-800 transition-colors">
          {t('catalog.shopCatalog')}
        </a>
      </div>

      <div id="full-cart-container" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Table Column (2/3) -->
        <div class="lg:col-span-2 border border-[#e5e5e5]">
          <table class="w-full text-left text-xs uppercase border-collapse">
            <thead>
              <tr class="bg-neutral-100 border-b border-[#e5e5e5]">
                <th class="p-3">{t('cart.product')}</th>
                <th class="p-3 text-center">{t('cart.price')}</th>
                <th class="p-3 text-center">{t('cart.quantity')}</th>
                <th class="p-3 text-right">{t('cart.subtotal')}</th>
                <th class="p-3 text-center"></th>
              </tr>
            </thead>
            <tbody id="cart-table-body" class="divide-y divide-[#e5e5e5]">
              <!-- Injected by JavaScript -->
            </tbody>
          </table>
        </div>

        <!-- Totals Column (1/3) -->
        <div class="lg:col-span-1 border border-[#e5e5e5] p-6 bg-neutral-50 flex flex-col justify-between">
          <div>
            <h2 class="text-lg font-heading font-black uppercase text-black mb-4 pb-2 border-b border-[#e5e5e5]">{t('cart.total')}</h2>
            <div class="flex justify-between items-center py-2 text-xs uppercase border-b border-[#e5e5e5]">
              <span>{t('cart.subtotal')}</span>
              <span id="page-cart-subtotal" class="font-bold">€0.00</span>
            </div>
            <div class="flex justify-between items-center py-2 text-xs uppercase border-b border-[#e5e5e5]">
              <span>Shipping</span>
              <span class="text-neutral-500 text-[11px]">Calculated at checkout</span>
            </div>
            <div class="flex justify-between items-center py-3 text-sm uppercase font-bold text-black border-b border-black">
              <span>{t('cart.total')}</span>
              <span id="page-cart-total" class="font-bold text-base">€0.00</span>
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-3">
            <a href={getLocalizedPath('/checkout/', lang)} class="block text-center py-3 bg-[#9f0712] hover:bg-[#B90A0E] text-white font-bold uppercase text-xs tracking-wider transition-colors">
              {t('cart.checkout')} &rarr;
            </a>
            <a href={getLocalizedPath('/shop/', lang)} class="block text-center py-2 border border-black text-black hover:bg-neutral-100 font-bold uppercase text-xs tracking-wider transition-colors">
              {t('cart.continueShopping')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  interface CartItem {
    id: number;
    name: string;
    slug: string;
    price: number;
    image: string;
    quantity: number;
  }

  function getCart(): CartItem[] {
    try {
      return JSON.parse(localStorage.getItem('gg_cart') || '[]');
    } catch {
      return [];
    }
  }

  function saveCart(cart: CartItem[]) {
    localStorage.setItem('gg_cart', JSON.stringify(cart));
    window.dispatchEvent(new Event('gg-cart-updated'));
    renderPageCart();
  }

  function renderPageCart() {
    const cart = getCart();
    const container = document.getElementById('full-cart-container');
    const emptyEl = document.getElementById('full-cart-empty');
    const tbody = document.getElementById('cart-table-body');
    const subtotalEl = document.getElementById('page-cart-subtotal');
    const totalEl = document.getElementById('page-cart-total');

    if (!container || !emptyEl || !tbody || !subtotalEl || !totalEl) return;

    if (cart.length === 0) {
      container.classList.add('hidden');
      emptyEl.classList.remove('hidden');
      return;
    }

    container.classList.remove('hidden');
    emptyEl.classList.add('hidden');

    const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
    subtotalEl.textContent = `€${subtotal.toFixed(2)}`;
    totalEl.textContent = `€${subtotal.toFixed(2)}`;

    tbody.innerHTML = cart.map((item, index) => `
      <tr class="hover:bg-neutral-50">
        <td class="p-3 flex items-center gap-3">
          <img src="${item.image}" alt="${item.name}" class="w-12 h-12 object-contain bg-white border border-[#e5e5e5] p-1" />
          <a href="/product/${item.slug}/" class="font-bold text-black hover:underline">${item.name}</a>
        </td>
        <td class="p-3 text-center">€${item.price.toFixed(2)}</td>
        <td class="p-3 text-center">
          <div class="inline-flex items-center border border-[#ccc]">
            <button class="page-qty-btn px-2 py-1 bg-white hover:bg-neutral-100 cursor-pointer border-0" data-index="${index}" data-change="-1">-</button>
            <span class="px-3 font-bold">${item.quantity}</span>
            <button class="page-qty-btn px-2 py-1 bg-white hover:bg-neutral-100 cursor-pointer border-0" data-index="${index}" data-change="1">+</button>
          </div>
        </td>
        <td class="p-3 text-right font-bold">€${(item.price * item.quantity).toFixed(2)}</td>
        <td class="p-3 text-center">
          <button class="page-remove-btn text-neutral-400 hover:text-black bg-transparent border-0 cursor-pointer p-1 text-sm" data-index="${index}">✕</button>
        </td>
      </tr>
    `).join('');

    tbody.querySelectorAll('.page-qty-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const idx = parseInt(target.dataset.index || '0');
        const change = parseInt(target.dataset.change || '0');
        const updated = getCart();
        if (updated[idx]) {
          updated[idx].quantity += change;
          if (updated[idx].quantity <= 0) {
            updated.splice(idx, 1);
          }
          saveCart(updated);
        }
      });
    });

    tbody.querySelectorAll('.page-remove-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const idx = parseInt(target.dataset.index || '0');
        const updated = getCart();
        updated.splice(idx, 1);
        saveCart(updated);
      });
    });
  }

  renderPageCart();
  window.addEventListener('storage', renderPageCart);
</script>
