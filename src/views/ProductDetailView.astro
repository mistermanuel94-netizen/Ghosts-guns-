---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import { useTranslations, getLocalizedPath, formatPrice, getProductTranslation, getCategoryTranslation, type Locale } from '../utils/i18n';
import { getSiloForProduct } from '../utils/silo';

interface Props {
  product: any;
  lang?: Locale;
}

const { product, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

// Localized product details
const translation = getProductTranslation(product.id, product.slug, lang);
const productName = translation?.name || product.name;
const productShortDesc = translation?.short_description || product.short_description;
const productDesc = translation?.description || product.description;

// Format Price in Euro
let priceNum = 0;
if (product.prices?.price) {
  const raw = parseFloat(product.prices.price);
  priceNum = (!product.prices.price.includes('.') && raw >= 100) ? raw / 100 : raw;
}
const formattedPrice = formatPrice(product.prices?.price);

// Images
const images = product.images && product.images.length > 0
  ? product.images.map((img: any) => img.localSrc || img.src)
  : ['/assets/images/logo-black.svg'];

const primaryImage = images[0];

// Silo Context & Related Products in the SAME Silo
const { pillar, spoke } = getSiloForProduct(product);
const spokeTr = getCategoryTranslation(spoke.slug, lang);
const spokeTitle = spokeTr?.name || spoke.defaultTitle;

const sameSiloSlugs = new Set(pillar.spokes.map(s => s.slug));
const sameSiloProducts = products.filter(p =>
  p.id !== product.id &&
  (p.categories || []).some((c: any) => sameSiloSlugs.has(c.slug))
);

const relatedProducts = (sameSiloProducts.length >= 4 ? sameSiloProducts : products.filter(p => p.id !== product.id)).slice(0, 4);
---

<Layout
  title={`${productName} | Ghost Guns`}
  description={productShortDesc ? productShortDesc.replace(/<[^>]*>?/gm, '') : `Buy ${productName} online from Ghost Guns.`}
  image={primaryImage}
  lang={lang}
>
  <div class="max-w-[1440px] mx-auto bg-white shadow-sm">
    <!-- 1. Hierarchical Silo Breadcrumbs Bar -->
    <div class="border-l border-r border-b border-neutral-300 bg-neutral-950 text-white px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-2 text-xs font-mono uppercase">
      <nav aria-label="Product Silo Breadcrumb" class="flex flex-wrap items-center gap-2 text-neutral-400">
        <a href={getLocalizedPath('/', lang)} class="hover:text-white transition-colors">{t('product.home')}</a>
        <span class="text-neutral-600">/</span>
        <a href={getLocalizedPath('/shop/', lang)} class="hover:text-white transition-colors">{t('product.shop')}</a>
        <span class="text-neutral-600">/</span>
        <a href={getLocalizedPath(pillar.path, lang)} class="text-[#ff4d58] hover:underline font-bold">
          {pillar.defaultTitle}
        </a>
        {spoke.slug !== pillar.slug && (
          <>
            <span class="text-neutral-600">/</span>
            <a href={getLocalizedPath(spoke.path, lang)} class="hover:text-white transition-colors">
              {spokeTitle}
            </a>
          </>
        )}
        <span class="text-neutral-600">/</span>
        <span class="text-white font-bold truncate max-w-[180px] sm:max-w-xs">{productName}</span>
      </nav>

      <div class="hidden md:flex items-center gap-2 text-[11px]">
        <span class="px-2 py-0.5 bg-neutral-900 border border-neutral-700 text-neutral-300">
          {pillar.code}
        </span>
        <span class="px-2 py-0.5 bg-[#9f0712] text-white font-bold">
          {spoke.specCode}
        </span>
      </div>
    </div>

    <!-- 2. Product Main Grid: 2 Columns (Gallery + Purchase Blueprint) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 border-l border-r border-b border-neutral-300">
      <!-- Left: Technical Image Gallery (7 cols) -->
      <div class="lg:col-span-7 p-6 sm:p-10 border-b lg:border-b-0 lg:border-r border-neutral-300 flex flex-col justify-between bg-blueprint-light">
        <div class="flex items-center justify-between text-[11px] font-mono uppercase text-neutral-500 mb-3">
          <span>OPTICAL INSPECTION // HIGH-RES VIEW</span>
          {product.sku && <span>PART ID: {product.sku}</span>}
        </div>

        <div class="w-full aspect-[4/3] max-h-[500px] bg-white border border-neutral-300 p-6 flex items-center justify-center overflow-hidden shadow-xs relative">
          <img
            id="main-product-image"
            src={primaryImage}
            alt={productName}
            class="max-h-full max-w-full object-contain transition-all duration-300"
          />
        </div>

        {images.length > 1 ? (
          <div class="flex flex-wrap gap-2.5 mt-5 justify-start">
            {images.map((img: string, idx: number) => (
              <button
                type="button"
                class={`thumb-btn w-20 h-20 p-1.5 border-2 bg-white cursor-pointer overflow-hidden transition-all ${
                  idx === 0 ? 'border-[#9f0712]' : 'border-neutral-300 hover:border-neutral-950'
                }`}
                data-src={img}
                aria-label={`View image ${idx + 1}`}
              >
                <img src={img} alt={`Thumbnail ${idx + 1}`} class="w-full h-full object-contain" />
              </button>
            ))}
          </div>
        ) : (
          <div class="mt-4 pt-3 border-t border-neutral-200 flex items-center justify-between text-[11px] font-mono text-neutral-500">
            <span>VERIFIED FACTORY COMPONENT</span>
            <span>READY FOR IMMEDIATE DISPATCH</span>
          </div>
        )}
      </div>

      <!-- Right: Specification & Purchase Controls (5 cols) -->
      <div class="lg:col-span-5 p-6 sm:p-10 flex flex-col justify-between bg-white">
        <div>
          <!-- Status & Silo Tag Row -->
          <div class="flex flex-wrap items-center gap-2 mb-4 font-mono text-xs uppercase">
            <span class="px-2.5 py-1 bg-emerald-700 text-white font-bold flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
              <span>{t('product.inStock')}</span>
            </span>
            <a
              href={getLocalizedPath(spoke.path, lang)}
              class="px-2.5 py-1 bg-neutral-100 hover:bg-neutral-950 text-neutral-800 hover:text-white border border-neutral-300 font-bold transition-colors"
            >
              SILO: {spokeTitle}
            </a>
            {product.sku && (
              <span class="text-neutral-500 text-[11px] ml-auto">{t('product.sku')}: {product.sku}</span>
            )}
          </div>

          <!-- Product Title -->
          <h1 class="text-2xl sm:text-4xl font-black uppercase text-neutral-950 font-heading leading-none tracking-tight mb-4">
            {productName}
          </h1>

          <!-- Price Box (Euro) -->
          <div class="p-4 bg-neutral-50 border border-neutral-300 mb-6 flex items-baseline justify-between">
            <div>
              <span class="block text-[10px] font-mono uppercase text-neutral-500 font-bold mb-0.5">
                UNIT PRICE // DIRECT SETTLEMENT
              </span>
              <div class="text-3xl font-black font-mono text-neutral-950">
                {formattedPrice}
              </div>
            </div>
            <span class="text-[11px] font-mono uppercase text-emerald-700 font-bold">
              ✓ NO FFL TRANSFER
            </span>
          </div>

          <!-- Short Description -->
          {productShortDesc && (
            <div class="text-sm font-sans text-neutral-700 leading-relaxed mb-6 prose" set:html={productShortDesc} />
          )}

          <!-- Purchase Controls -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-5 border-t border-neutral-200 mb-8">
            <div class="flex items-center border-2 border-neutral-950 bg-white h-[48px] w-fit">
              <button id="qty-minus" type="button" class="px-4 h-full bg-white text-neutral-950 font-mono text-base font-bold hover:bg-neutral-100 cursor-pointer border-0">-</button>
              <input id="product-qty" type="number" value="1" min="1" class="w-14 h-full text-center text-sm font-mono font-bold border-0 focus:outline-none text-neutral-950" />
              <button id="qty-plus" type="button" class="px-4 h-full bg-white text-neutral-950 font-mono text-base font-bold hover:bg-neutral-100 cursor-pointer border-0">+</button>
            </div>

            <button
              id="add-to-cart-btn"
              type="button"
              data-id={product.id}
              data-name={productName}
              data-slug={product.slug}
              data-price={priceNum}
              data-image={primaryImage}
              class="flex-1 h-[48px] px-6 bg-[#9f0712] hover:bg-neutral-950 text-white font-mono font-bold uppercase text-xs sm:text-sm tracking-wider transition-colors border-0 cursor-pointer flex items-center justify-center gap-2.5 shadow-sm"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
              </svg>
              <span>{t('product.addToCart')}</span>
            </button>
          </div>

          <!-- Silo Technical Spec Matrix -->
          <div class="mb-6">
            <span class="block text-[10px] font-mono uppercase tracking-widest text-neutral-500 font-bold mb-2">
              {pillar.code} // PLATFORM TELEMETRY
            </span>
            <div class="grid grid-cols-2 gap-2">
              {pillar.technicalSpecs.map((spec) => (
                <div class="p-2.5 bg-neutral-50 border border-neutral-200">
                  <span class="block text-[9px] font-mono uppercase text-neutral-400">{spec.label}</span>
                  <span class="block text-[11px] font-mono font-bold text-neutral-900 truncate">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- 4 Tactical Assurance Badges -->
        <div class="grid grid-cols-2 gap-2.5 text-[11px] font-mono uppercase text-neutral-800 pt-5 border-t border-neutral-200">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-[#9f0712] shrink-0"></span>
            <span class="font-bold">{t('product.trustBadge1')}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-[#9f0712] shrink-0"></span>
            <span class="font-bold">{t('product.trustBadge2')}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-[#9f0712] shrink-0"></span>
            <span class="font-bold">{t('product.trustBadge3')}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-[#9f0712] shrink-0"></span>
            <span class="font-bold">{t('product.trustBadge4')}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Product Engineering Description & Silo Cross-Links -->
    <div class="grid grid-cols-1 lg:grid-cols-12 border-l border-r border-b border-neutral-300">
      <div class="lg:col-span-8 p-6 sm:p-10 border-b lg:border-b-0 lg:border-r border-neutral-300 bg-white">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-neutral-200">
          <span class="w-2.5 h-5 bg-[#9f0712]"></span>
          <h2 class="text-xl font-heading font-black uppercase text-neutral-950 m-0">
            {t('product.specifications')} & Overview
          </h2>
        </div>
        {productDesc ? (
          <div class="text-sm font-sans text-neutral-800 leading-relaxed max-w-none prose" set:html={productDesc} />
        ) : (
          <div class="text-sm font-sans text-neutral-700 leading-relaxed space-y-3">
            <p>{productShortDesc ? productShortDesc.replace(/<[^>]*>?/gm, '') : `${productName} is engineered to strict dimensional tolerances for private builders.`}</p>
            <p>Part of our <strong>{pillar.defaultTitle}</strong> architecture ({spoke.specCode}). Inspected in-house and packaged for discreet pan-European and international dispatch.</p>
          </div>
        )}
      </div>

      <!-- Right Sidebar: Complete Your Silo Ecosystem -->
      <div class="lg:col-span-4 p-6 sm:p-8 bg-neutral-50 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#9f0712] font-bold block mb-1">
            SILO INTERCONNECTIVITY //
          </span>
          <h3 class="text-lg font-heading font-black uppercase text-neutral-950 mb-3">
            Explore {pillar.defaultTitle}
          </h3>
          <p class="text-xs text-neutral-600 mb-4 leading-relaxed">
            Navigate sibling categories inside this hardware silo to source compatible jigs, rails, filaments, and completion components:
          </p>
          <div class="flex flex-col gap-2 mb-6">
            {pillar.spokes.map((s) => (
              <a
                href={getLocalizedPath(s.path, lang)}
                class={`p-3 border font-mono text-xs uppercase flex items-center justify-between transition-colors ${
                  s.slug === spoke.slug
                    ? 'bg-neutral-950 text-white border-neutral-950 font-bold'
                    : 'bg-white hover:bg-neutral-900 hover:text-white text-neutral-900 border-neutral-300'
                }`}
              >
                <span>{s.defaultTitle}</span>
                <span class="text-[10px] opacity-75">[{s.specCode}] &rarr;</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Related Build Guide Card -->
        {pillar.relatedGuides.length > 0 && (
          <div class="p-4 bg-neutral-950 text-white border border-neutral-900">
            <span class="text-[9px] font-mono uppercase text-[#ff4d58] font-bold block mb-1">
              TECHNICAL BRIEFING //
            </span>
            <a
              href={getLocalizedPath(`/blog/${pillar.relatedGuides[0].slug}/`, lang)}
              class="text-xs font-mono font-bold text-white hover:text-[#ff4d58] uppercase leading-snug block"
            >
              {pillar.relatedGuides[0].title} &rarr;
            </a>
          </div>
        )}
      </div>
    </div>

    <!-- 4. Related Products in the Same Silo -->
    <div class="border-neutral-300 border-r border-l border-b px-4 sm:px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-neutral-100">
      <div>
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-[#9f0712] block mb-0.5">
          SAME SILO RECOMMENDATIONS // {pillar.code}
        </span>
        <div class="flex items-center gap-2.5">
          <h3 class="uppercase font-black text-neutral-950 text-xl sm:text-2xl m-0 leading-none font-heading">
            {t('product.relatedProducts')}
          </h3>
          <div class="w-2.5 h-5 bg-neutral-950"></div>
        </div>
      </div>
      <a href={getLocalizedPath(pillar.path, lang)} class="px-4 py-1.5 bg-neutral-950 hover:bg-[#9f0712] text-white font-mono text-xs font-bold uppercase transition-colors self-start sm:self-auto">
        {t('sections.viewAll')} {pillar.defaultTitle.split('&')[0]} &rarr;
      </a>
    </div>

    <ul class="products list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-l border-t border-neutral-300">
      {relatedProducts.map((p: any) => (
        <ProductCard product={p} lang={lang} />
      ))}
    </ul>
  </div>
</Layout>

<script>
  function initProductDetail() {
    const mainImg = document.getElementById('main-product-image') as HTMLImageElement | null;
    const thumbBtns = document.querySelectorAll('.thumb-btn');

    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-src');
        if (src && mainImg) {
          mainImg.src = src;
          thumbBtns.forEach((b) => {
            b.classList.remove('border-[#9f0712]');
            b.classList.add('border-neutral-300');
          });
          btn.classList.remove('border-neutral-300');
          btn.classList.add('border-[#9f0712]');
        }
      });
    });

    const minusBtn = document.getElementById('qty-minus');
    const plusBtn = document.getElementById('qty-plus');
    const qtyInput = document.getElementById('product-qty') as HTMLInputElement | null;

    if (minusBtn && !minusBtn.hasAttribute('data-bound')) {
      minusBtn.setAttribute('data-bound', 'true');
      minusBtn.addEventListener('click', () => {
        if (!qtyInput) return;
        const val = parseInt(qtyInput.value, 10) || 1;
        if (val > 1) qtyInput.value = (val - 1).toString();
      });
    }

    if (plusBtn && !plusBtn.hasAttribute('data-bound')) {
      plusBtn.setAttribute('data-bound', 'true');
      plusBtn.addEventListener('click', () => {
        if (!qtyInput) return;
        const val = parseInt(qtyInput.value, 10) || 1;
        qtyInput.value = (val + 1).toString();
      });
    }

    const addBtn = document.getElementById('add-to-cart-btn');
    if (addBtn && !addBtn.hasAttribute('data-bound')) {
      addBtn.setAttribute('data-bound', 'true');
      addBtn.addEventListener('click', () => {
        const id = parseInt(addBtn.dataset.id || '0', 10);
        const name = addBtn.dataset.name || '';
        const slug = addBtn.dataset.slug || '';
        const price = parseFloat(addBtn.dataset.price || '0');
        const image = addBtn.dataset.image || '';
        const quantity = parseInt(qtyInput?.value || '1', 10) || 1;

        try {
          const cart = JSON.parse(localStorage.getItem('gg_cart') || '[]');
          const existing = cart.find((item: any) => item.id === id);
          if (existing) {
            existing.quantity += quantity;
          } else {
            cart.push({ id, name, slug, price, image, quantity });
          }
          localStorage.setItem('gg_cart', JSON.stringify(cart));
          window.dispatchEvent(new Event('gg-cart-updated'));
          window.dispatchEvent(new Event('gg-open-cart'));
        } catch (e) {
          console.error(e);
        }
      });
    }
  }

  initProductDetail();
  document.addEventListener('astro:page-load', initProductDetail);
</script>
