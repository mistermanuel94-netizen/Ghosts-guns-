---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import NichePillarSection from '../components/NichePillarSection.astro';
import products from '../data/products.json';
import { useTranslations, getLocalizedPath, LOCALES, LANGUAGES, type Locale } from '../utils/i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

// Group products for the homepage showcase matching live site & new catalog additions
const printerSlugs = ['bambu-lab-p2s-3d-printer', 'elegoo-centauri-carbon-3d-printer', 'prusa-core-one-plus-3d-printer', 'creality-sparkx-i7-3d-printer'];
const mostPopularSlugs = ['3d-printed-g19-build-kit', 'harlot', 'ar15-lower-receiver-80', 'pbs-17-build-kit'];
const precisionSlugs = ['glock-19-slide-parts-kit', 'bambu-lab-pa-cf-filament', 'ar15-80-percent-lower-jig-kit', 'high-impact-pla-plus-pro-filament'];
const latestSlugs = ['g80-build-kit-polymer', 'g80-jig-polymer', 'hardened-steel-high-temp-nozzle-kit', 'ar15-magpul-m3-30rd-mag'];

const printerProducts = printerSlugs.map(slug => products.find(p => p.slug === slug)).filter(Boolean);
const mostPopularProducts = mostPopularSlugs.map(slug => products.find(p => p.slug === slug)).filter(Boolean);
const precisionProducts = precisionSlugs.map(slug => products.find(p => p.slug === slug)).filter(Boolean);
const latestProducts = latestSlugs.map(slug => products.find(p => p.slug === slug)).filter(Boolean);
---

<Layout
  title={lang === 'en' ? "Ghost Guns | 3D Printed & 80 Percent Ghost Gun Kits" : `Ghost Guns | ${t('sections.stopScrollingTitle')}`}
  description={t('sections.stopScrollingDesc')}
  lang={lang}
>
  <div class="lg:container lg:mx-auto">
    <!-- 1. Hero Slider -->
    <Hero lang={lang} />

    <!-- 1. Hero Slider -->
    <Hero lang={lang} />

    <!-- 2. Section: Featured 3D Printers -->
    <div class="border-[#e5e5e5] border-r border-l border-b px-3 pt-5 pb-3 flex justify-between items-center bg-neutral-50/60">
      <div class="flex items-center gap-2">
        <h3 class="uppercase font-black text-black text-xl md:text-2xl m-0 leading-none font-heading flex items-center gap-2">
          <span>{t('sections.featuredPrinters')}</span>
          <span class="text-[10px] bg-[#9f0712] text-white px-2 py-0.5 rounded-none font-mono font-bold tracking-wider">NEW SILO</span>
        </h3>
        <div class="w-[12px] h-[24px] bg-[#9f0712]"></div>
      </div>
      <a href={getLocalizedPath('/3d-printers/', lang)} class="text-[#9f0712] font-bold underline font-mono text-sm hover:text-black">{t('sections.viewAll')}</a>
    </div>

    <ul class="products list-none m-0 p-0 grid grid-cols-2 lg:grid-cols-4 border-l border-r border-b border-[#e5e5e5]">
      {printerProducts.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </ul>

    <!-- 4. Section: Most Popular Build Kits -->
    <div class="border-[#e5e5e5] border-r border-l border-b px-3 pt-5 pb-3 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <h3 class="uppercase font-black text-black text-xl md:text-2xl m-0 leading-none font-heading">{t('sections.mostPopular')}</h3>
        <div class="w-[12px] h-[24px] bg-black"></div>
      </div>
      <a href={getLocalizedPath('/most-popular/', lang)} class="text-black underline font-mono text-sm hover:text-gray-600">{t('sections.viewAll')}</a>
    </div>

    <ul class="products list-none m-0 p-0 grid grid-cols-2 lg:grid-cols-4 border-l border-r border-b border-[#e5e5e5]">
      {mostPopularProducts.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </ul>

    <!-- 5. Niche Authority Pillar SEO Section -->
    <NichePillarSection lang={lang} />

    <!-- 6. Section: Precision Hardware, Jigs & Engineering Filaments -->
    <div class="border-[#e5e5e5] border-r border-l border-b px-3 pt-5 pb-3 flex justify-between items-center bg-neutral-50/60">
      <div class="flex items-center gap-2">
        <h3 class="uppercase font-black text-black text-xl md:text-2xl m-0 leading-none font-heading">{t('sections.precisionParts')}</h3>
        <div class="w-[12px] h-[24px] bg-black"></div>
      </div>
      <a href={getLocalizedPath('/component/', lang)} class="text-black underline font-mono text-sm hover:text-gray-600">{t('sections.viewAll')}</a>
    </div>

    <ul class="products list-none m-0 p-0 grid grid-cols-2 lg:grid-cols-4 border-l border-r border-b border-[#e5e5e5]">
      {precisionProducts.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </ul>

    <!-- 7. Section: Latest Products -->
    <div class="border-[#e5e5e5] border-r border-l border-t border-b px-3 pt-5 pb-3 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <h3 class="uppercase font-black text-black text-xl md:text-2xl m-0 leading-none font-heading">{t('sections.latestProducts')}</h3>
        <div class="w-[12px] h-[24px] bg-black"></div>
      </div>
      <a href={getLocalizedPath('/shop/?orderby=date', lang)} class="text-black underline font-mono text-sm hover:text-gray-600">{t('sections.viewAll')}</a>
    </div>

    <ul class="products list-none m-0 p-0 grid grid-cols-2 lg:grid-cols-4 border-l border-r border-b border-[#e5e5e5]">
      {latestProducts.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </ul>

    <!-- 8. Callout Banner: Stop Scrolling. Start Building. -->
    <div class="flex flex-col md:flex-row h-[600px] md:h-[400px] border-r md:border-r-0 border-t border-[#e5e5e5]">
      <div class="flex flex-none md:flex-1 border-l border-l-[#e5e5e5] border-r border-r-white flex-col justify-center">
        <div class="flex flex-col gap-[8px] px-[12px] p-[24px]">
          <p class="uppercase text-black text-xs m-0 font-mono">{t('sections.stopScrollingTag')}</p>
          <p class="uppercase font-black text-black text-3xl md:text-4xl m-0 font-heading">{t('sections.stopScrollingTitle')}</p>
          <p class="uppercase text-black text-xs m-0">{t('sections.stopScrollingDesc')}</p>
          <a
            href={getLocalizedPath('/shop/', lang)}
            class="text-white bg-black border border-[#e5e5e5] inline-block text-xs py-[8px] px-[24px] uppercase self-start hover:bg-neutral-800 font-mono font-bold mt-2"
          >
            {t('sections.shopNow')}
          </a>
        </div>
      </div>
      <div
        class="flex-1 md:h-auto border-t md:border-t-0 border-l border-r border-[#e5e5e5] bg-cover bg-center"
        style="background-image: url('/assets/images/learn.png');"
      >
      </div>
    </div>

    <!-- 9. Dedicated In-Page Multi-Language Switcher Bar -->
    <div class="border-l border-r border-b border-[#e5e5e5] bg-black text-white p-6 md:p-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#9f0712] block mb-1">GLOBAL STOREFRONT // 8 LOCALES</span>
          <h4 class="text-base md:text-lg font-heading font-black uppercase text-white m-0 tracking-wide">{t('sections.selectLanguage')}</h4>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2">
          {LOCALES.map(loc => {
            const meta = LANGUAGES[loc];
            const isActive = loc === lang;
            const targetUrl = getLocalizedPath(Astro.url.pathname, loc);
            return (
              <a
                href={targetUrl}
                class={`px-3 py-1.5 text-xs font-mono font-bold uppercase transition-all flex items-center gap-1.5 border ${
                  isActive 
                    ? 'bg-[#9f0712] text-white border-[#9f0712] shadow-sm' 
                    : 'bg-neutral-900 text-neutral-300 border-neutral-700 hover:border-white hover:text-white'
                }`}
              >
                <span>{meta.flag}</span>
                <span>{meta.code.toUpperCase()}</span>
                <span class="hidden sm:inline text-[10px] opacity-75 font-normal">({meta.nativeName})</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</Layout>
