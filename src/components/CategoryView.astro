---
import Layout from '../layouts/Layout.astro';
import ProductCard from './ProductCard.astro';
import products from '../data/products.json';
import { useTranslations, getLocalizedPath, getCategoryTranslation, type Locale } from '../utils/i18n';
import { SILO_PILLARS, getSiloForCategory, getCategoryProductCount } from '../utils/silo';

interface Props {
  title?: string;
  categorySlug: string;
  subCategorySlugs?: string[];
  description?: string;
  lang?: Locale;
}

const {
  title,
  categorySlug,
  subCategorySlugs = [],
  description,
  lang = 'en'
} = Astro.props;

const t = useTranslations(lang);
const catTr = getCategoryTranslation(categorySlug, lang);
const displayTitle = catTr?.name || title || categorySlug;
const rawDesc = catTr?.description || description || `Browse our catalog of ${displayTitle}. All items in stock and ready to ship.`;
const displayDesc = rawDesc.replace(/<[^>]*>?/gm, '').trim();

// Determine parent Silo Pillar and Sibling Spokes for true Silo Architecture
const parentPillar = getSiloForCategory(categorySlug);
const pillarSpokeSlugs = parentPillar.spokes.map(s => s.slug);

// Filter matching products: if visiting a main hub, include its subCategorySlugs
const matchingSlugs = [categorySlug, ...subCategorySlugs];
const categoryProducts = products.filter(p =>
  p.categories && p.categories.some((c: any) => matchingSlugs.includes(c.slug))
);

// Fallback: if category has 0 directly tagged products, show parent pillar products
const displayProducts = categoryProducts.length > 0
  ? categoryProducts
  : products.filter(p => p.categories && p.categories.some((c: any) => pillarSpokeSlugs.includes(c.slug))).slice(0, 8);

// Dynamic hero background based on category
const heroBgImage = categorySlug.includes('3d')
  ? '/assets/images/hero-bg.webp'
  : categorySlug.includes('80') || categorySlug.includes('build')
  ? '/assets/images/hero-pbs.webp'
  : '/assets/images/hero-bg.webp';
---

<Layout title={`${displayTitle} | Ghost Guns`} description={displayDesc} lang={lang}>
  <div class="max-w-[1440px] mx-auto bg-white shadow-sm">
    <!-- 1. Silo Category Hero Section -->
    <div class="relative bg-neutral-950 text-white border-l border-r border-b border-neutral-300 overflow-hidden bg-blueprint-grid">
      <div
        class="absolute inset-0 bg-cover bg-center opacity-25 mix-blend-luminosity filter contrast-125 pointer-events-none"
        style={`background-image: url('${heroBgImage}');`}
      ></div>
      <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/85 to-neutral-950/40 pointer-events-none"></div>

      <div class="relative z-10 px-4 sm:px-8 py-10 sm:py-14 max-w-6xl mx-auto">
        <!-- Hierarchical Silo Breadcrumbs -->
        <nav aria-label="Silo Breadcrumb" class="text-[11px] font-mono uppercase text-neutral-400 flex flex-wrap items-center gap-2 mb-5 pb-4 border-b border-neutral-800/80">
          <a href={getLocalizedPath('/', lang)} class="hover:text-white transition-colors">{t('product.home')}</a>
          <span class="text-neutral-600">/</span>
          <a href={getLocalizedPath('/shop/', lang)} class="hover:text-white transition-colors">{t('product.shop')}</a>
          <span class="text-neutral-600">/</span>
          {parentPillar.slug !== categorySlug && (
            <>
              <a href={getLocalizedPath(parentPillar.path, lang)} class="text-[#ff4d58] hover:underline font-bold">
                {parentPillar.defaultTitle}
              </a>
              <span class="text-neutral-600">/</span>
            </>
          )}
          <span class="text-white font-bold bg-white/10 px-2 py-0.5">{displayTitle}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
          <div class="lg:col-span-8">
            <!-- Silo Code Tag -->
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#9f0712]/25 border border-[#9f0712] text-[#ff4d58] text-xs font-mono uppercase tracking-widest font-bold mb-3">
              <span class="w-1.5 h-1.5 bg-[#9f0712] rounded-full animate-pulse"></span>
              <span>{parentPillar.code} // {t('categoryHero.tag')}</span>
            </div>

            <!-- Master Category Title -->
            <div class="flex items-center gap-3 mb-3">
              <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black uppercase text-white font-heading tracking-tight leading-none m-0">
                {displayTitle}
              </h1>
              <div class="w-3 h-8 sm:h-11 bg-[#9f0712] shrink-0"></div>
            </div>

            <!-- Category Description -->
            <p class="text-xs sm:text-sm md:text-base text-neutral-300 font-sans leading-relaxed max-w-3xl m-0">
              {displayDesc}
            </p>
          </div>

          <!-- Right: 3 Telemetry Stat Boxes + Technical Specs -->
          <div class="lg:col-span-4 grid grid-cols-3 gap-2 text-center">
            <div class="p-3 bg-neutral-900/90 border border-neutral-800">
              <span class="block text-xl sm:text-2xl font-black text-white font-mono leading-none mb-1">
                {displayProducts.length}
              </span>
              <span class="block text-[9px] sm:text-[10px] font-mono uppercase text-neutral-400">
                {t('categoryHero.statInStock')}
              </span>
            </div>
            <div class="p-3 bg-neutral-900/90 border border-neutral-800">
              <span class="block text-xl sm:text-2xl font-black text-[#ff4d58] font-mono leading-none mb-1">100%</span>
              <span class="block text-[9px] sm:text-[10px] font-mono uppercase text-neutral-400">
                {t('categoryHero.statShipping')}
              </span>
            </div>
            <div class="p-3 bg-neutral-900/90 border border-neutral-800">
              <span class="block text-xl sm:text-2xl font-black text-white font-mono leading-none mb-1">€ EUR</span>
              <span class="block text-[9px] sm:text-[10px] font-mono uppercase text-neutral-400">
                {t('categoryHero.statCurrency')}
              </span>
            </div>
          </div>
        </div>

        <!-- Silo Spoke Sub-Navigation (Shows all sibling spokes inside the current Silo Hub) -->
        <div class="mt-8 pt-6 border-t border-neutral-800">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <span class="text-[10px] font-mono uppercase tracking-widest text-neutral-400 font-bold">
              {parentPillar.code} // SILO SPOKE NAVIGATION (INTERNAL CLUSTER):
            </span>
            <a href={getLocalizedPath(parentPillar.path, lang)} class="text-[11px] font-mono text-[#ff4d58] hover:underline uppercase font-bold">
              PARENT HUB: {parentPillar.defaultTitle} &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2">
            {parentPillar.spokes.map((spoke) => {
              const isCurrentSpoke = spoke.slug === categorySlug;
              const spokeCount = getCategoryProductCount(spoke.slug);
              const spokeTr = getCategoryTranslation(spoke.slug, lang);
              const spokeTitle = spokeTr?.name || spoke.defaultTitle;
              return (
                <a
                  href={getLocalizedPath(spoke.path, lang)}
                  class={`p-3 border transition-all flex flex-col justify-between ${
                    isCurrentSpoke
                      ? 'bg-[#9f0712] border-[#9f0712] text-white'
                      : 'bg-neutral-900/80 border-neutral-800 hover:border-neutral-500 text-neutral-200'
                  }`}
                >
                  <div class="flex items-center justify-between gap-1 mb-1">
                    <span class={`text-[9px] font-mono font-bold uppercase ${isCurrentSpoke ? 'text-white/90' : 'text-[#ff4d58]'}`}>
                      {spoke.specCode}
                    </span>
                    <span class="text-[10px] font-mono font-bold">({spokeCount})</span>
                  </div>
                  <span class="text-xs font-heading font-bold uppercase leading-tight block">
                    {spokeTitle}
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Sticky Filter, Live Search & Sort Toolbar -->
    <div class="sticky top-[52px] lg:top-[94px] z-40 bg-white border-l border-r border-b border-neutral-300 px-4 sm:px-6 py-3.5 shadow-xs">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <!-- Left: Primary Silo Switcher Chips -->
        <div class="w-full lg:w-auto overflow-hidden">
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar whitespace-nowrap py-0.5 text-xs font-mono">
            <a
              href={getLocalizedPath('/shop/', lang)}
              class="px-3 py-1.5 uppercase font-bold text-[11px] shrink-0 border bg-neutral-100 border-neutral-300 hover:border-neutral-950 text-neutral-900 transition-colors"
            >
              {t('categoryHero.allCategories') || 'All Silos'} (76)
            </a>
            {SILO_PILLARS.map((pillar) => {
              const isPillarActive = pillar.slug === categorySlug || pillar.spokes.some(s => s.slug === categorySlug);
              return (
                <a
                  href={getLocalizedPath(pillar.path, lang)}
                  class={`px-3 py-1.5 uppercase font-bold text-[11px] shrink-0 transition-colors flex items-center gap-1.5 border ${
                    isPillarActive
                      ? 'bg-neutral-950 text-white border-neutral-950'
                      : 'bg-white border-neutral-300 hover:border-neutral-950 text-neutral-800'
                  }`}
                >
                  <span class={isPillarActive ? 'text-[#ff4d58]' : 'text-neutral-400'}>
                    {pillar.code.split('//')[0].replace('SILO ', '')}
                  </span>
                  <span>{pillar.defaultTitle.split('&')[0].trim()}</span>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Right: Quick Filter Input + Sort Selector -->
        <div class="flex flex-wrap items-center justify-between lg:justify-end gap-3 shrink-0 border-t lg:border-t-0 pt-2.5 lg:pt-0 border-neutral-200">
          <div class="relative flex-1 sm:flex-initial sm:w-52">
            <input
              type="search"
              id="category-live-filter"
              placeholder="FILTER THIS SILO..."
              class="w-full h-[34px] px-3 text-xs font-mono uppercase bg-neutral-50 border border-neutral-300 focus:border-neutral-950 focus:bg-white focus:outline-none text-neutral-950"
            />
          </div>

          <span id="category-showing-count" class="text-xs font-mono text-neutral-500 uppercase tracking-tight hidden sm:inline">
            {t('catalog.showingAll').replace('{count}', displayProducts.length.toString())}
          </span>

          <div class="flex items-center gap-1.5">
            <label for="category-sort-select" class="text-xs font-mono text-neutral-600 uppercase font-bold hidden xl:inline">
              {t('catalog.sortLabel')}
            </label>
            <div class="relative">
              <select
                id="category-sort-select"
                class="appearance-none h-[34px] bg-white border border-neutral-300 hover:border-neutral-950 text-neutral-950 font-mono text-xs px-3 pr-8 cursor-pointer uppercase font-bold focus:outline-none focus:border-neutral-950 rounded-none transition-colors"
                aria-label={t('catalog.sortLabel')}
              >
                <option value="default">{t('catalog.sortDefault')}</option>
                <option value="popularity">{t('catalog.sortPopularity')}</option>
                <option value="date">{t('catalog.sortLatest')}</option>
                <option value="price-asc">{t('catalog.sortPriceAsc')}</option>
                <option value="price-desc">{t('catalog.sortPriceDesc')}</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-neutral-800">
                <svg class="fill-current h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Products Grid -->
    <ul id="category-product-grid" class="products list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 border-l border-t border-neutral-300">
      {displayProducts.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </ul>

    <!-- 4. Silo Technical Specifications & Related Build Guides Footer Block -->
    <section class="border-l border-r border-b border-neutral-300 bg-neutral-50 p-6 sm:p-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Technical Telemetry for this Silo -->
        <div class="lg:col-span-7">
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#9f0712] font-bold block mb-1">
            {parentPillar.code} // ENGINEERING TELEMETRY
          </span>
          <h2 class="text-xl sm:text-2xl font-heading font-black uppercase text-neutral-950 mb-4">
            {parentPillar.defaultTitle} — Technical Specifications
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {parentPillar.technicalSpecs.map((spec) => (
              <div class="p-3.5 bg-white border border-neutral-300">
                <span class="block text-[10px] font-mono uppercase text-neutral-500 mb-1">{spec.label}</span>
                <span class="block text-xs font-mono font-bold text-neutral-950 uppercase">{spec.value}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Related Build Guides in this Silo -->
        <div class="lg:col-span-5 bg-neutral-950 text-white p-6 border border-neutral-900">
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#ff4d58] font-bold block mb-1">
            SILO KNOWLEDGE CLUSTER //
          </span>
          <h3 class="text-lg font-heading font-black uppercase text-white mb-4">
            Recommended Build Guides
          </h3>
          <div class="flex flex-col gap-3">
            {parentPillar.relatedGuides.map((guide) => (
              <a
                href={getLocalizedPath(`/blog/${guide.slug}/`, lang)}
                class="p-3 bg-neutral-900 hover:bg-[#9f0712] border border-neutral-800 transition-colors block group"
              >
                <span class="text-[9px] font-mono uppercase text-[#ff4d58] group-hover:text-white font-bold block mb-1">
                  {guide.tag}
                </span>
                <span class="text-xs font-mono font-bold text-white uppercase leading-snug block">
                  {guide.title} &rarr;
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function initCategoryControls() {
    const sortSelect = document.getElementById('category-sort-select') as HTMLSelectElement | null;
    const filterInput = document.getElementById('category-live-filter') as HTMLInputElement | null;
    const productGrid = document.getElementById('category-product-grid');

    if (!productGrid) return;
    const originalItems = Array.from(productGrid.querySelectorAll('li.product')) as HTMLElement[];

    function applySortAndFilter() {
      const sortValue = sortSelect?.value || 'default';
      const query = (filterInput?.value || '').trim().toLowerCase();

      const sortedItems = [...originalItems];

      switch (sortValue) {
        case 'popularity':
          sortedItems.sort((a, b) => parseFloat(b.dataset.popularity || '0') - parseFloat(a.dataset.popularity || '0'));
          break;
        case 'price-asc':
          sortedItems.sort((a, b) => parseFloat(a.dataset.price || '0') - parseFloat(b.dataset.price || '0'));
          break;
        case 'price-desc':
          sortedItems.sort((a, b) => parseFloat(b.dataset.price || '0') - parseFloat(a.dataset.price || '0'));
          break;
        case 'date':
          sortedItems.sort((a, b) => parseInt(b.dataset.id || '0', 10) - parseInt(a.dataset.id || '0', 10));
          break;
        default:
          break;
      }

      sortedItems.forEach((item) => {
        const name = item.dataset.name || '';
        const matches = !query || name.includes(query);
        item.style.display = matches ? '' : 'none';
        productGrid.appendChild(item);
      });
    }

    const urlParams = new URLSearchParams(window.location.search);
    const initialSort = urlParams.get('orderby');
    if (sortSelect && initialSort && ['popularity', 'date', 'price-asc', 'price-desc', 'default'].includes(initialSort)) {
      sortSelect.value = initialSort;
      applySortAndFilter();
    }

    sortSelect?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      applySortAndFilter();
      const newUrl = new URL(window.location.href);
      if (val === 'default') {
        newUrl.searchParams.delete('orderby');
      } else {
        newUrl.searchParams.set('orderby', val);
      }
      window.history.replaceState({}, '', newUrl.toString());
    });

    filterInput?.addEventListener('input', applySortAndFilter);
  }

  initCategoryControls();
  document.addEventListener('astro:page-load', initCategoryControls);
</script>
