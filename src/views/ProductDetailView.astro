---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import { useTranslations, getLocalizedPath, formatPrice, getProductTranslation, type Locale } from '../utils/i18n';

interface Props {
  product: any;
  lang?: Locale;
}

const { product, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

// Localized product details
const translation = getProductTranslation(product.id, product.slug, lang);
const productName = translation?.name || product.name;
const productShortDesc = translation?.short_description || product.short_description;
const productDesc = translation?.description || product.description;

// Format Price in Euro
let priceNum = 0;
if (product.prices?.price) {
  priceNum = parseFloat(product.prices.price) / 100;
}
const formattedPrice = formatPrice(product.prices?.price);

// Images
const images = product.images && product.images.length > 0 
  ? product.images.map((img: any) => img.localSrc || img.src)
  : ['/assets/images/logo-black.svg'];

const primaryImage = images[0];

// Related products
const relatedProducts = products
  .filter(p => p.id !== product.id)
  .slice(0, 4);
---

<Layout
  title={`${productName} | Ghost Guns`}
  description={productShortDesc ? productShortDesc.replace(/<[^>]*>?/gm, '') : `Buy ${productName} online from Ghost Guns.`}
  image={primaryImage}
  lang={lang}
>
  <div class="lg:container lg:mx-auto">
    <!-- Breadcrumbs -->
    <div class="border-l border-r border-b border-[#e5e5e5] px-4 py-3 text-xs font-mono uppercase text-neutral-500 flex items-center gap-2">
      <a href={getLocalizedPath('/', lang)} class="hover:text-black">{t('product.home')}</a>
      <span>/</span>
      <a href={getLocalizedPath('/shop/', lang)} class="hover:text-black">{t('product.shop')}</a>
      <span>/</span>
      <span class="text-black font-bold truncate max-w-[200px] md:max-w-none">{productName}</span>
    </div>

    <!-- Product Main Grid: 2 Columns (Gallery + Details) -->
    <div class="grid grid-cols-1 md:grid-cols-2 border-l border-r border-b border-[#e5e5e5]">
      <!-- Left: Gallery -->
      <div class="p-6 md:p-10 border-b md:border-b-0 md:border-r border-[#e5e5e5] flex flex-col items-center justify-center bg-white">
        <div class="w-full aspect-[4/3] max-w-[500px] bg-[#f9f9f9] border border-[#e5e5e5] p-4 flex items-center justify-center overflow-hidden">
          <img
            id="main-product-image"
            src={primaryImage}
            alt={productName}
            class="max-h-full max-w-full object-contain transition-all duration-300"
          />
        </div>

        {images.length > 1 && (
          <div class="flex flex-wrap gap-2 mt-4 justify-center">
            {images.map((img: string, idx: number) => (
              <button
                class={`thumb-btn w-16 h-16 p-1 border bg-neutral-50 cursor-pointer overflow-hidden ${idx === 0 ? 'border-black' : 'border-[#e5e5e5]'}`}
                data-src={img}
                aria-label={`View image ${idx + 1}`}
              >
                <img src={img} alt={`Thumbnail ${idx + 1}`} class="w-full h-full object-contain" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Right: Details & Purchase -->
      <div class="p-6 md:p-10 flex flex-col justify-between">
        <div>
          <!-- Category & Status Tag -->
          <div class="flex items-center gap-2 mb-2 font-mono text-xs uppercase">
            <span class="px-2 py-0.5 bg-black text-white font-bold">{t('product.inStock')}</span>
            {product.sku && <span class="text-neutral-500">{t('product.sku')}: {product.sku}</span>}
          </div>

          <!-- Product Title -->
          <h1 class="text-2xl md:text-4xl font-black uppercase text-black font-heading leading-tight mb-4">
            {productName}
          </h1>

          <!-- Price (Euro) -->
          <div class="text-2xl font-bold font-mono text-black mb-6">
            {formattedPrice}
          </div>

          <!-- Short Description -->
          {productShortDesc && (
            <div class="text-sm font-sans text-neutral-700 leading-relaxed mb-6 prose" set:html={productShortDesc} />
          )}

          <!-- Purchase Controls -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-4 border-t border-[#e5e5e5] mb-8">
            <div class="flex items-center border border-[#ccc] w-fit">
              <button id="qty-minus" class="px-3 py-2 bg-white text-black font-mono text-sm hover:bg-neutral-100 cursor-pointer border-0">-</button>
              <input id="product-qty" type="number" value="1" min="1" class="w-12 text-center text-sm font-mono border-0 focus:outline-none" />
              <button id="qty-plus" class="px-3 py-2 bg-white text-black font-mono text-sm hover:bg-neutral-100 cursor-pointer border-0">+</button>
            </div>

            <button
              id="add-to-cart-btn"
              data-id={product.id}
              data-name={productName}
              data-slug={product.slug}
              data-price={priceNum}
              data-image={primaryImage}
              class="flex-1 py-3 px-6 bg-[#9f0712] hover:bg-[#B90A0E] text-white font-mono font-bold uppercase text-sm tracking-wider transition-colors border-0 cursor-pointer flex items-center justify-center gap-2"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
              </svg>
              {t('product.addToCart')}
            </button>
          </div>
        </div>

        <!-- Trust Badges -->
        <div class="grid grid-cols-2 gap-2 text-xs font-mono uppercase text-neutral-600 pt-6 border-t border-[#e5e5e5]">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-black"></span>
            {t('product.trustBadge1')}
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-black"></span>
            {t('product.trustBadge2')}
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-black"></span>
            {t('product.trustBadge3')}
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-black"></span>
            {t('product.trustBadge4')}
          </div>
        </div>
      </div>
    </div>

    <!-- Product Description / Details Tabs -->
    {productDesc && (
      <div class="border-l border-r border-b border-[#e5e5e5] p-6 md:p-10 bg-neutral-50/50">
        <h3 class="text-xl font-heading font-black uppercase text-black mb-4">{t('product.specifications')}</h3>
        <div class="text-sm font-sans text-neutral-800 leading-relaxed max-w-none prose" set:html={productDesc} />
      </div>
    )}

    <!-- Related Products -->
    <div class="border-[#e5e5e5] border-r border-l border-t border-b px-3 pt-4 pb-3 flex justify-between items-center mt-8">
      <div class="flex items-center gap-2">
        <h3 class="uppercase font-black text-black text-xl m-0 leading-none font-heading">{t('product.relatedProducts')}</h3>
        <div class="w-[12px] h-[24px] bg-black"></div>
      </div>
      <a href={getLocalizedPath('/shop/', lang)} class="text-black underline font-mono text-sm hover:text-gray-600">{t('sections.viewAll')}</a>
    </div>

    <ul class="products list-none m-0 p-0 grid grid-cols-2 lg:grid-cols-4 border-l border-r border-b border-[#e5e5e5]">
      {relatedProducts.map((p: any) => (
        <ProductCard product={p} lang={lang} />
      ))}
    </ul>
  </div>
</Layout>

<script>
  // Image gallery switching
  const mainImg = document.getElementById('main-product-image') as HTMLImageElement;
  const thumbBtns = document.querySelectorAll('.thumb-btn');

  thumbBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-src');
      if (src && mainImg) {
        mainImg.src = src;
        thumbBtns.forEach(b => b.classList.replace('border-black', 'border-[#e5e5e5]'));
        btn.classList.replace('border-[#e5e5e5]', 'border-black');
      }
    });
  });

  // Quantity controls
  const minusBtn = document.getElementById('qty-minus');
  const plusBtn = document.getElementById('qty-plus');
  const qtyInput = document.getElementById('product-qty') as HTMLInputElement;

  minusBtn?.addEventListener('click', () => {
    let val = parseInt(qtyInput.value) || 1;
    if (val > 1) qtyInput.value = (val - 1).toString();
  });

  plusBtn?.addEventListener('click', () => {
    let val = parseInt(qtyInput.value) || 1;
    qtyInput.value = (val + 1).toString();
  });

  // Add to cart action
  const addBtn = document.getElementById('add-to-cart-btn');
  addBtn?.addEventListener('click', () => {
    const id = parseInt(addBtn.dataset.id || '0');
    const name = addBtn.dataset.name || '';
    const slug = addBtn.dataset.slug || '';
    const price = parseFloat(addBtn.dataset.price || '0');
    const image = addBtn.dataset.image || '';
    const quantity = parseInt(qtyInput?.value || '1') || 1;

    try {
      const cart = JSON.parse(localStorage.getItem('gg_cart') || '[]');
      const existing = cart.find((item: any) => item.id === id);
      if (existing) {
        existing.quantity += quantity;
      } else {
        cart.push({ id, name, slug, price, image, quantity });
      }
      localStorage.setItem('gg_cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('gg-cart-updated'));
      window.dispatchEvent(new Event('gg-open-cart'));
    } catch (e) {
      console.error(e);
    }
  });
</script>
