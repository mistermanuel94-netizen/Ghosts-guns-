---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import NichePillarSection from '../components/NichePillarSection.astro';
import products from '../data/products.json';
import { useTranslations, getLocalizedPath, LOCALES, LANGUAGES, type Locale } from '../utils/i18n';
import { SILO_PILLARS, getCategoryProductCount } from '../utils/silo';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

// Group products for the homepage showcase matching live site & new catalog additions
const printerSlugs = ['bambu-lab-p2s-3d-printer', 'elegoo-centauri-carbon-3d-printer', 'prusa-core-one-plus-3d-printer', 'creality-sparkx-i7-3d-printer'];
const mostPopularSlugs = ['3d-printed-g19-build-kit', 'harlot', 'ar15-lower-receiver-80', 'pbs-17-build-kit'];
const precisionSlugs = ['glock-19-slide-parts-kit', 'bambu-lab-pa-cf-filament', 'ar15-80-percent-lower-jig-kit', 'high-impact-pla-plus-pro-filament'];
const latestSlugs = ['g80-build-kit', 'g80-jig', 'hardened-steel-high-temp-nozzle-kit', 'ar15-anodized-lower-receiver-80'];

const printerProducts = printerSlugs.map(slug => products.find(p => p.slug === slug)).filter(Boolean);
const mostPopularProducts = mostPopularSlugs.map(slug => products.find(p => p.slug === slug)).filter(Boolean);
const precisionProducts = precisionSlugs.map(slug => products.find(p => p.slug === slug)).filter(Boolean);
const latestProducts = latestSlugs.map(slug => products.find(p => p.slug === slug)).filter(Boolean);
---

<Layout
  title={lang === 'en' ? "Ghost Guns | 3D Printed & 80 Percent Ghost Gun Kits" : `Ghost Guns | ${t('sections.stopScrollingTitle')}`}
  description={t('sections.stopScrollingDesc')}
  lang={lang}
>
  <div class="max-w-[1440px] mx-auto bg-white shadow-sm">
    <!-- 1. Hero Slider (Single, High-Impact) -->
    <Hero lang={lang} />

    <!-- 2. Interactive Silo Architecture Quick-Jump Bar -->
    <section class="border-l border-r border-b border-neutral-300 bg-neutral-100 px-4 sm:px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-[#9f0712]"></span>
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-neutral-900">
            ARCHITECTURAL SILO DIRECTORY // 5 PRIMARY HARDWARE HUBS
          </span>
        </div>
        <span class="text-[11px] font-mono text-neutral-500 uppercase">
          SELECT A SILO HUB TO FILTER BY PLATFORM &rarr;
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
        {SILO_PILLARS.map((pillar) => {
          const count = getCategoryProductCount(pillar.slug, pillar.spokes.map(s => s.slug));
          return (
            <a
              href={getLocalizedPath(pillar.path, lang)}
              class="p-3.5 bg-white hover:bg-neutral-950 text-neutral-950 hover:text-white border border-neutral-300 hover:border-neutral-950 transition-all group flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <span class="text-[10px] font-mono font-bold text-[#9f0712] group-hover:text-[#ff4d58] uppercase">
                    {pillar.code.split('//')[0].trim()}
                  </span>
                  <span class="text-[10px] font-mono bg-neutral-100 group-hover:bg-white/15 text-neutral-700 group-hover:text-white px-1.5 py-0.5 font-bold">
                    {count} ITEMS
                  </span>
                </div>
                <h2 class="text-sm font-heading font-black uppercase tracking-tight leading-snug m-0">
                  {pillar.defaultTitle}
                </h2>
              </div>
              <div class="mt-3 pt-2 border-t border-neutral-100 group-hover:border-neutral-800 flex items-center justify-between text-[10px] font-mono text-neutral-500 group-hover:text-neutral-300">
                <span>{pillar.spokes.length} SUB-SILOS</span>
                <span class="font-bold text-neutral-950 group-hover:text-white">EXPLORE &rarr;</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- 3. SILO 01 SHOWCASE: Featured CoreXY 3D Printers -->
    <div class="border-neutral-300 border-r border-l border-b px-4 sm:px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-neutral-50">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-[#9f0712]">SILO 01 // ADDITIVE HARDWARE</span>
          <span class="text-[10px] bg-[#9f0712] text-white px-2 py-0.5 font-mono font-bold tracking-wider">NEW SILO</span>
        </div>
        <div class="flex items-center gap-3">
          <h3 class="uppercase font-black text-neutral-950 text-2xl md:text-3xl m-0 leading-none font-heading">
            {t('sections.featuredPrinters')}
          </h3>
          <div class="w-3 h-6 bg-[#9f0712]"></div>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
        <a href={getLocalizedPath('/3d-printing/3d-files/', lang)} class="px-3 py-1.5 bg-white border border-neutral-300 hover:border-neutral-950 text-neutral-800 uppercase font-bold">
          3D CAD Files
        </a>
        <a href={getLocalizedPath('/3d-printing/3d-printer-accessories/', lang)} class="px-3 py-1.5 bg-white border border-neutral-300 hover:border-neutral-950 text-neutral-800 uppercase font-bold">
          Nozzles & Upgrades
        </a>
        <a href={getLocalizedPath('/3d-printers/', lang)} class="px-4 py-1.5 bg-[#9f0712] hover:bg-neutral-950 text-white font-bold uppercase transition-colors">
          {t('sections.viewAll')} (10) &rarr;
        </a>
      </div>
    </div>

    <ul class="products list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-l border-t border-neutral-300">
      {printerProducts.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </ul>

    <!-- 4. SILO 02 SHOWCASE: Most Popular Complete Build Kits -->
    <div class="border-neutral-300 border-r border-l border-b px-4 sm:px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white">
      <div>
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-neutral-500 block mb-1">
          SILO 02 // COMPLETE DIY PLATFORMS
        </span>
        <div class="flex items-center gap-3">
          <h3 class="uppercase font-black text-neutral-950 text-2xl md:text-3xl m-0 leading-none font-heading">
            {t('sections.mostPopular')}
          </h3>
          <div class="w-3 h-6 bg-neutral-950"></div>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
        <a href={getLocalizedPath('/build-kit/', lang)} class="px-3 py-1.5 bg-neutral-100 border border-neutral-300 hover:border-neutral-950 text-neutral-800 uppercase font-bold">
          All Build Kits (26)
        </a>
        <a href={getLocalizedPath('/most-popular/', lang)} class="px-4 py-1.5 bg-neutral-950 hover:bg-[#9f0712] text-white font-bold uppercase transition-colors">
          {t('sections.viewAll')} &rarr;
        </a>
      </div>
    </div>

    <ul class="products list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-l border-t border-neutral-300">
      {mostPopularProducts.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </ul>

    <!-- 5. Master Silo Architecture Matrix & Authority Hub -->
    <NichePillarSection lang={lang} />

    <!-- 6. SILO 03 & 04 SHOWCASE: Precision Hardware, Jigs & Engineering Filaments -->
    <div class="border-neutral-300 border-r border-l border-b px-4 sm:px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-neutral-50">
      <div>
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-[#9f0712] block mb-1">
          SILO 03 & 04 // MACHINING, RAILS & POLYMERS
        </span>
        <div class="flex items-center gap-3">
          <h3 class="uppercase font-black text-neutral-950 text-2xl md:text-3xl m-0 leading-none font-heading">
            {t('sections.precisionParts')}
          </h3>
          <div class="w-3 h-6 bg-neutral-950"></div>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
        <a href={getLocalizedPath('/component/slide/', lang)} class="px-3 py-1.5 bg-white border border-neutral-300 hover:border-neutral-950 text-neutral-800 uppercase font-bold">
          Slides
        </a>
        <a href={getLocalizedPath('/component/rails/', lang)} class="px-3 py-1.5 bg-white border border-neutral-300 hover:border-neutral-950 text-neutral-800 uppercase font-bold">
          FMDA Rails
        </a>
        <a href={getLocalizedPath('/accessories/jigs/', lang)} class="px-3 py-1.5 bg-white border border-neutral-300 hover:border-neutral-950 text-neutral-800 uppercase font-bold">
          Router Jigs
        </a>
        <a href={getLocalizedPath('/component/', lang)} class="px-4 py-1.5 bg-neutral-950 hover:bg-[#9f0712] text-white font-bold uppercase transition-colors">
          {t('sections.viewAll')} &rarr;
        </a>
      </div>
    </div>

    <ul class="products list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-l border-t border-neutral-300">
      {precisionProducts.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </ul>

    <!-- 7. Latest Catalog Drops & 80% Receivers -->
    <div class="border-neutral-300 border-r border-l border-b px-4 sm:px-6 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white">
      <div>
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-neutral-500 block mb-1">
          WAREHOUSE TELEMETRY // NEW ARRIVALS
        </span>
        <div class="flex items-center gap-3">
          <h3 class="uppercase font-black text-neutral-950 text-2xl md:text-3xl m-0 leading-none font-heading">
            {t('sections.latestProducts')}
          </h3>
          <div class="w-3 h-6 bg-neutral-950"></div>
        </div>
      </div>
      <a href={getLocalizedPath('/shop/?orderby=date', lang)} class="px-4 py-1.5 bg-neutral-950 hover:bg-[#9f0712] text-white font-mono text-xs font-bold uppercase transition-colors self-start sm:self-auto">
        {t('sections.viewAll')} &rarr;
      </a>
    </div>

    <ul class="products list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-l border-t border-neutral-300">
      {latestProducts.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </ul>

    <!-- 8. Callout Banner: Stop Scrolling. Start Building. -->
    <div class="grid grid-cols-1 lg:grid-cols-2 border-l border-r border-b border-neutral-300 bg-neutral-950 text-white">
      <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center border-b lg:border-b-0 lg:border-r border-neutral-800">
        <span class="text-xs font-mono uppercase text-[#ff4d58] font-bold tracking-widest mb-3">
          {t('sections.stopScrollingTag')}
        </span>
        <h2 class="uppercase font-black text-white text-3xl sm:text-4xl lg:text-5xl m-0 mb-4 font-heading leading-none">
          {t('sections.stopScrollingTitle')}
        </h2>
        <p class="text-neutral-300 text-sm sm:text-base leading-relaxed m-0 mb-8 max-w-xl">
          {t('sections.stopScrollingDesc')}
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={getLocalizedPath('/shop/', lang)}
            class="text-white bg-[#9f0712] hover:bg-[#b90a0e] px-7 py-3.5 text-xs uppercase font-mono font-bold tracking-wider transition-colors"
          >
            {t('sections.shopNow')} &rarr;
          </a>
          <a
            href={getLocalizedPath('/blog/', lang)}
            class="text-white bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 px-6 py-3.5 text-xs uppercase font-mono font-bold tracking-wider transition-colors"
          >
            READ BUILD GUIDES
          </a>
        </div>
      </div>
      <div
        class="min-h-[320px] lg:min-h-[420px] bg-cover bg-center relative"
        style="background-image: url('/assets/images/learn.png');"
      >
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 p-4 bg-black/80 backdrop-blur-xs border border-neutral-800 flex items-center justify-between font-mono text-xs">
          <span>76 VERIFIED PLATFORMS READY FOR DISPATCH</span>
          <span class="text-[#ff4d58] font-bold">NO FFL // 100% PRIVATE</span>
        </div>
      </div>
    </div>

    <!-- 9. Dedicated Multi-Language Storefront Switcher Bar -->
    <div class="border-l border-r border-b border-neutral-300 bg-neutral-900 text-white p-6 md:p-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#ff4d58] font-bold block mb-1">
            EUROPEAN & INTERNATIONAL STOREFRONT // 8 NATIVE LOCALES
          </span>
          <h4 class="text-base md:text-lg font-heading font-black uppercase text-white m-0 tracking-wide">
            {t('sections.selectLanguage')}
          </h4>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2">
          {LOCALES.map(loc => {
            const meta = LANGUAGES[loc];
            const isActive = loc === lang;
            const targetUrl = getLocalizedPath(Astro.url.pathname, loc);
            return (
              <a
                href={targetUrl}
                class={`px-3 py-1.5 text-xs font-mono font-bold uppercase transition-all flex items-center gap-1.5 border ${
                  isActive
                    ? 'bg-[#9f0712] text-white border-[#9f0712] shadow-sm'
                    : 'bg-neutral-950 text-neutral-300 border-neutral-700 hover:border-white hover:text-white'
                }`}
              >
                <span>{meta.flag}</span>
                <span>{meta.code.toUpperCase()}</span>
                <span class="hidden sm:inline text-[10px] opacity-75 font-normal">({meta.nativeName})</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</Layout>
