<script>
  function initHeroSlider() {
    let currentSlide = 0;
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.hero-dot');
    const tabs = document.querySelectorAll('.hero-tab');
    const totalSlides = slides.length;
    let autoplayTimer: any = null;

    if (!totalSlides) return;

    function showSlide(index: number) {
      currentSlide = (index + totalSlides) % totalSlides;
      
      // Update Slide Elements
      slides.forEach((slide, i) => {
        if (i === currentSlide) {
          slide.classList.remove('opacity-0', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0');
        }
      });

      // Update Mobile Dots
      dots.forEach((dot, i) => {
        if (i === currentSlide) {
          dot.classList.remove('bg-white/40');
          dot.classList.add('bg-[#9f0712]');
        } else {
          dot.classList.remove('bg-[#9f0712]');
          dot.classList.add('bg-white/40');
        }
      });

      // Update Desktop Tabs
      tabs.forEach((tab, i) => {
        const titleSpan = tab.querySelector('span:nth-child(2)');
        const dotIndicator = tab.querySelector('div:last-child');
        const kikerSpan = tab.querySelector('span:first-child');
        
        if (i === currentSlide) {
          tab.classList.add('bg-neutral-900', 'border-t-2', 'border-t-[#9f0712]');
          if (titleSpan) {
            titleSpan.classList.remove('text-neutral-400');
            titleSpan.classList.add('text-white');
          }
          if (kikerSpan) {
            kikerSpan.classList.remove('text-neutral-500');
            kikerSpan.classList.add('text-[#9f0712]');
          }
          if (dotIndicator) {
            dotIndicator.classList.remove('bg-neutral-700');
            dotIndicator.classList.add('bg-[#9f0712]');
          }
        } else {
          tab.classList.remove('bg-neutral-900', 'border-t-2', 'border-t-[#9f0712]');
          if (titleSpan) {
            titleSpan.classList.remove('text-white');
            titleSpan.classList.add('text-neutral-400');
          }
          if (kikerSpan) {
            kikerSpan.classList.remove('text-[#9f0712]');
            kikerSpan.classList.add('text-neutral-500');
          }
          if (dotIndicator) {
            dotIndicator.classList.remove('bg-[#9f0712]');
            dotIndicator.classList.add('bg-neutral-700');
          }
        }
      });
    }

    const prevBtn = document.querySelector('.hero-arrow-prev');
    const nextBtn = document.querySelector('.hero-arrow-next');

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        showSlide(currentSlide - 1);
        resetAutoplay();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        showSlide(currentSlide + 1);
        resetAutoplay();
      });
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        showSlide(idx);
        resetAutoplay();
      });
    });

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        showSlide(idx);
        resetAutoplay();
      });
    });

    function resetAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
      autoplayTimer = setInterval(() => {
        showSlide(currentSlide + 1);
      }, 6500);
    }

    resetAutoplay();

    // Pause autoplay on mouse hover over hero container
    const sliderContainer = document.querySelector('.hero-slider');
    if (sliderContainer) {
      sliderContainer.addEventListener('mouseenter', () => {
        if (autoplayTimer) clearInterval(autoplayTimer);
      });
      sliderContainer.addEventListener('mouseleave', () => {
        resetAutoplay();
      });
    }
  }

  initHeroSlider();
  document.addEventListener('astro:page-load', initHeroSlider);
</script>
