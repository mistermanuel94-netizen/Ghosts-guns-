---
import CategoryView from '../../../components/CategoryView.astro';
import { LOCALES, type Locale } from '../../../utils/i18n';

export function getStaticPaths() {
  return LOCALES.filter(l => l !== 'en').map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---

<CategoryView
  categorySlug="80-firearm"
  lang={lang as Locale}
/>
