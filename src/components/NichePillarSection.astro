---
import { getLocalizedPath, useTranslations, getCategoryTranslation, type Locale } from '../utils/i18n';
import { SILO_PILLARS, getCategoryProductCount } from '../utils/silo';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="border-l border-r border-b border-neutral-300 bg-neutral-950 text-white py-14 px-4 sm:px-6 md:px-10 bg-blueprint-grid">
  <div class="max-w-[1360px] mx-auto">
    <!-- Top Architectural Header -->
    <div class="border-b border-neutral-800 pb-8 mb-10 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#9f0712]/25 border border-[#9f0712] text-[#ff4d58] text-xs font-mono uppercase tracking-widest font-bold mb-3">
          <span class="w-2 h-2 bg-[#9f0712]"></span>
          <span>{t('nichePillar.tag')}</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black uppercase text-white leading-none tracking-tight max-w-4xl m-0">
          {t('nichePillar.title')}
        </h2>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={getLocalizedPath('/shop/', lang)}
          class="inline-flex items-center gap-2 px-6 py-3.5 bg-[#9f0712] hover:bg-[#b90a0e] text-white font-mono text-xs uppercase font-bold tracking-wider transition-colors shrink-0"
        >
          <span>{t('nichePillar.explorePillar')}</span>
          <span>&rarr;</span>
        </a>
        <a
          href={getLocalizedPath('/blog/', lang)}
          class="inline-flex items-center gap-2 px-5 py-3.5 bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 text-white font-mono text-xs uppercase font-bold tracking-wider transition-colors shrink-0"
        >
          <span>TECHNICAL GUIDES</span>
        </a>
      </div>
    </div>

    <!-- Lead Technical Summary -->
    <p class="text-sm sm:text-base font-sans text-neutral-300 leading-relaxed max-w-4xl mb-10">
      {t('nichePillar.intro')}
    </p>

    <!-- 5-Pillar Master Silo Matrix (Hubs + Spokes + Live Inventory Counts + Spec Telemetry) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {SILO_PILLARS.map((pillar, idx) => {
        const catTrans = getCategoryTranslation(pillar.slug, lang);
        const pillarTitle = catTrans?.name || pillar.defaultTitle;
        const spokeSlugs = pillar.spokes.map(s => s.slug);
        const totalInSilo = getCategoryProductCount(pillar.slug, spokeSlugs);

        return (
          <div class={`border flex flex-col justify-between transition-all p-6 ${
            idx === 0
              ? 'md:col-span-2 lg:col-span-1 border-[#9f0712] bg-neutral-900/90 shadow-[0_0_30px_rgba(159,7,18,0.15)]'
              : 'border-neutral-800 bg-neutral-900/60 hover:border-neutral-600'
          }`}>
            <div>
              <!-- Pillar Top Telemetry Row -->
              <div class="flex items-center justify-between gap-2 pb-3 mb-4 border-b border-neutral-800">
                <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[#ff4d58]">
                  {pillar.code}
                </span>
                <span class="text-[10px] font-mono font-bold uppercase px-2 py-0.5 bg-white/10 text-white border border-white/15">
                  {totalInSilo} ITEMS IN SILO
                </span>
              </div>

              <!-- Pillar Title & Description -->
              <h3 class="text-xl sm:text-2xl font-heading font-black uppercase text-white mb-2 leading-tight">
                <a href={getLocalizedPath(pillar.path, lang)} class="hover:text-[#ff4d58] transition-colors">
                  {pillarTitle}
                </a>
              </h3>
              <p class="text-xs text-neutral-400 font-sans leading-relaxed mb-5">
                {pillar.subtitle}
              </p>

              <!-- Direct Sub-Silo Spoke Directory -->
              <div class="mb-5">
                <span class="block text-[10px] font-mono uppercase tracking-widest text-neutral-500 font-bold mb-2">
                  DIRECT SUB-SILO SPOKES //
                </span>
                <div class="flex flex-col gap-1.5">
                  {pillar.spokes.map((spoke) => {
                    const spokeCatTr = getCategoryTranslation(spoke.slug, lang);
                    const spokeName = spokeCatTr?.name || spoke.defaultTitle;
                    const count = getCategoryProductCount(spoke.slug);
                    return (
                      <a
                        href={getLocalizedPath(spoke.path, lang)}
                        class="flex items-center justify-between px-3 py-2 bg-neutral-950/80 hover:bg-[#9f0712] border border-neutral-800 hover:border-[#9f0712] text-xs font-mono transition-colors group"
                      >
                        <div class="flex items-center gap-2 truncate">
                          <span class="text-[10px] text-neutral-500 group-hover:text-white font-bold">[{spoke.specCode}]</span>
                          <span class="text-neutral-200 group-hover:text-white font-bold uppercase truncate">{spokeName}</span>
                        </div>
                        <span class="text-[10px] text-neutral-400 group-hover:text-white shrink-0 ml-2">
                          ({count}) &rarr;
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>

            <!-- Technical Specs Footer inside Pillar Card -->
            <div class="pt-4 border-t border-neutral-800/80">
              <div class="grid grid-cols-2 gap-2 mb-4">
                {pillar.technicalSpecs.slice(0, 2).map((spec) => (
                  <div class="bg-neutral-950 p-2 border border-neutral-800/80">
                    <span class="block text-[9px] font-mono uppercase text-neutral-500">{spec.label}</span>
                    <span class="block text-[10px] font-mono font-bold text-neutral-200 truncate">{spec.value}</span>
                  </div>
                ))}
              </div>
              <a
                href={getLocalizedPath(pillar.path, lang)}
                class="w-full py-2.5 px-4 bg-white hover:bg-[#9f0712] text-neutral-950 hover:text-white font-mono text-xs font-bold uppercase tracking-wider transition-colors flex items-center justify-between"
              >
                <span>ENTER {pillar.code.split('//')[0].trim()}</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        );
      })}

      <!-- 6th Card: Technical Knowledge Base & Build Guides Hub -->
      <div class="border border-neutral-800 bg-neutral-900/60 hover:border-neutral-600 p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 pb-3 mb-4 border-b border-neutral-800">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-emerald-400">
              SILO 06 // KNOWLEDGE BASE
            </span>
            <span class="text-[10px] font-mono font-bold uppercase px-2 py-0.5 bg-emerald-950 text-emerald-300 border border-emerald-700">
              VERIFIED GUIDES
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-heading font-black uppercase text-white mb-2 leading-tight">
            <a href={getLocalizedPath('/blog/', lang)} class="hover:text-emerald-400 transition-colors">
               Gunsmithing & 3D Build Guides
            </a>
          </h3>
          <p class="text-xs text-neutral-400 font-sans leading-relaxed mb-5">
            Step-by-step technical documentation, slicer calibration parameters, and platform comparisons connecting directly to our hardware silos.
          </p>

          <span class="block text-[10px] font-mono uppercase tracking-widest text-neutral-500 font-bold mb-2">
            FEATURED TECHNICAL ARTICLES //
          </span>
          <div class="flex flex-col gap-2 mb-5">
            <a
              href={getLocalizedPath('/blog/best-3d-printed-gun-builds-to-start-with-from-easy-to-advanced/', lang)}
              class="p-3 bg-neutral-950/90 hover:bg-neutral-800 border border-neutral-800 transition-colors block"
            >
              <span class="text-[9px] font-mono uppercase text-[#ff4d58] font-bold block mb-0.5">01 // ROADMAP</span>
              <span class="text-xs font-mono font-bold text-white uppercase leading-snug block">
                Best 3D Printed Gun Builds to Start With (Easy to Advanced)
              </span>
            </a>
            <a
              href={getLocalizedPath('/blog/why-the-harlot-22-is-the-easiest-3d-printed-gun-you-can-build/', lang)}
              class="p-3 bg-neutral-950/90 hover:bg-neutral-800 border border-neutral-800 transition-colors block"
            >
              <span class="text-[9px] font-mono uppercase text-[#ff4d58] font-bold block mb-0.5">02 // ENTRY PLATFORM</span>
              <span class="text-xs font-mono font-bold text-white uppercase leading-snug block">
                Why the Harlot .22 Is the Easiest 3D Printed Build
              </span>
            </a>
            <a
              href={getLocalizedPath('/blog/what-is-a-ghost-gun-everything-you-need-to-know-in-2026/', lang)}
              class="p-3 bg-neutral-950/90 hover:bg-neutral-800 border border-neutral-800 transition-colors block"
            >
              <span class="text-[9px] font-mono uppercase text-[#ff4d58] font-bold block mb-0.5">03 // BRIEFING</span>
              <span class="text-xs font-mono font-bold text-white uppercase leading-snug block">
                What Is a Ghost Gun? Everything You Need to Know in 2026
              </span>
            </a>
          </div>
        </div>

        <div class="pt-4 border-t border-neutral-800/80">
          <a
            href={getLocalizedPath('/blog/', lang)}
            class="w-full py-2.5 px-4 bg-[#9f0712] hover:bg-[#b90a0e] text-white font-mono text-xs font-bold uppercase tracking-wider transition-colors flex items-center justify-between"
          >
            <span>OPEN TECHNICAL ARCHIVE</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
