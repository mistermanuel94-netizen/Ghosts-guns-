---
import Layout from '../layouts/Layout.astro';
import { useTranslations, type Locale } from '../utils/i18n';
import pagesTranslationsData from '../data/pages-translations.json';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const pageData = (pagesTranslationsData as any)['contact']?.[lang] || (pagesTranslationsData as any)['contact']?.['en'];
---

<Layout title={`${pageData.title}`} description={pageData.subheading} lang={lang}>
  <div class="content-page-wrapper w-full font-sans">
    <div class="w-full flex-grow bg-white flex flex-col">
      <div class="lg:container lg:mx-auto lg:border-l lg:border-r border-[#e5e5e5] flex-grow flex flex-col">
        <div class="flex-grow px-4 md:px-6 py-8">
          
          <!-- Hero Section -->
          <div class="w-full border-b border-[#e5e5e5]">
            <div class="px-[12px] py-[24px] md:py-[48px]">
              <p class="text-xs uppercase text-[#9f0712] m-0 mb-2 font-mono">// {pageData.subheading}</p>
              <h1 class="uppercase font-bold text-black text-3xl md:text-4xl m-0 font-heading tracking-tight">{pageData.heading}</h1>
              <p class="text-black text-sm mt-4 m-0 max-w-xl font-mono">{pageData.hours || 'Monday – Friday: 9:00 AM – 5:00 PM CST'}</p>
            </div>
          </div>

          <!-- Two-Column Layout: Form + Contact Info -->
          <div class="w-full">
            <div class="grid grid-cols-1 lg:grid-cols-3 border-b border-[#e5e5e5]">
              <!-- Form Column (2/3) -->
              <div class="lg:col-span-2 border-b lg:border-b-0 lg:border-r border-[#e5e5e5]">
                <div class="border-b border-[#e5e5e5] px-[12px] py-[12px]">
                  <p class="uppercase font-bold text-black text-lg m-0 font-heading">{pageData.formTitle}</p>
                </div>
                <div class="p-[12px] md:p-[24px]">
                  <form id="contact-form" class="flex flex-col gap-4 max-w-xl">
                    <div class="flex flex-col gap-1">
                      <label for="contact-name" class="text-xs uppercase font-bold font-mono text-black">{pageData.namePlaceholder} *</label>
                      <input type="text" id="contact-name" name="name" required placeholder={pageData.namePlaceholder} class="w-full px-3 py-2 border border-[#ccc] focus:border-black focus:outline-none font-mono text-sm" />
                    </div>

                    <div class="flex flex-col gap-1">
                      <label for="contact-email" class="text-xs uppercase font-bold font-mono text-black">{pageData.emailPlaceholder} *</label>
                      <input type="email" id="contact-email" name="email" required placeholder={pageData.emailPlaceholder} class="w-full px-3 py-2 border border-[#ccc] focus:border-black focus:outline-none font-mono text-sm" />
                    </div>

                    <div class="flex flex-col gap-1">
                      <label for="contact-subject" class="text-xs uppercase font-bold font-mono text-black">{pageData.subjectPlaceholder} *</label>
                      <input type="text" id="contact-subject" name="subject" required placeholder={pageData.subjectPlaceholder} class="w-full px-3 py-2 border border-[#ccc] focus:border-black focus:outline-none font-mono text-sm" />
                    </div>

                    <div class="flex flex-col gap-1">
                      <label for="contact-message" class="text-xs uppercase font-bold font-mono text-black">{pageData.messagePlaceholder} *</label>
                      <textarea id="contact-message" name="message" rows="5" required placeholder={pageData.messagePlaceholder} class="w-full px-3 py-2 border border-[#ccc] focus:border-black focus:outline-none font-mono text-sm"></textarea>
                    </div>

                    <button type="submit" class="bg-black hover:bg-[#9f0712] text-white font-mono text-xs uppercase font-bold px-6 py-3 transition-colors tracking-wider w-max cursor-pointer">
                      {pageData.submitBtn}
                    </button>

                    <div id="contact-status" class="hidden p-3 bg-green-50 border border-green-200 text-green-800 text-xs font-mono">
                      ✓ Your message has been sent successfully. Our team will respond shortly.
                    </div>
                  </form>
                </div>
              </div>

              <!-- Contact Info Column (1/3) -->
              <div class="lg:col-span-1">
                <div class="border-b border-[#e5e5e5] px-[12px] py-[12px]">
                  <p class="uppercase font-bold text-black text-lg m-0 font-heading">Info</p>
                </div>
                <div class="p-[12px] md:p-[24px] flex flex-col gap-6 font-mono">
                  <div>
                    <p class="uppercase font-bold text-black text-xs m-0 mb-1">{pageData.addressLabel || 'HEADQUARTERS'}</p>
                    <p class="text-neutral-700 text-sm m-0 leading-relaxed">{pageData.address || '2320 Donley Dr Suite C, Austin TX 78758'}</p>
                  </div>
                  <div>
                    <p class="uppercase font-bold text-black text-xs m-0 mb-1">{pageData.emailLabel || 'EMAIL'}</p>
                    <a href="mailto:support@ghost-guns.shop" class="text-black text-sm hover:text-[#9f0712] transition-colors block font-bold">support@ghost-guns.shop</a>
                    <a href="mailto:ghostgunseu.pro@gmail.com" class="text-neutral-700 text-sm hover:text-[#9f0712] transition-colors block mt-1">ghostgunseu.pro@gmail.com</a>
                  </div>
                  <div>
                    <p class="uppercase font-bold text-black text-xs m-0 mb-1">{pageData.phoneLabel || 'PHONE'}</p>
                    <a href={`tel:${pageData.phone || '(855) 754-4678'}`} class="text-black text-sm hover:text-[#9f0712] transition-colors">{pageData.phone || '(855) 754-4678'}</a>
                  </div>
                  <div>
                    <p class="uppercase font-bold text-black text-xs m-0 mb-1">{pageData.hoursLabel || 'BUSINESS HOURS'}</p>
                    <p class="text-neutral-700 text-sm m-0 leading-relaxed">{pageData.hours || 'Monday – Friday: 9:00 AM – 5:00 PM CST'}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- FAQ Accordion Section -->
          {pageData.faqs && pageData.faqs.length > 0 && (
            <div class="w-full border-b border-[#e5e5e5]">
              <div class="border-b border-[#e5e5e5] px-[12px] py-[12px]">
                <p class="uppercase font-bold text-black text-lg m-0 font-heading">{pageData.faqsTitle || 'FREQUENTLY ASKED QUESTIONS'}</p>
              </div>
              <div class="faq-accordion divide-y divide-[#e5e5e5]">
                {pageData.faqs.map((faq: any) => (
                  <details class="group">
                    <summary class="flex justify-between items-center px-[12px] py-[16px] md:py-[18px] cursor-pointer hover:bg-neutral-50 transition-colors">
                      <span class="uppercase font-bold text-black text-sm pr-4 font-heading">{faq.q}</span>
                      <span class="faq-icon text-black text-xl font-light shrink-0 transition-transform duration-200 group-open:rotate-45">+</span>
                    </summary>
                    <div class="px-[12px] pb-[16px] md:pb-[18px]">
                      <p class="text-neutral-700 text-sm m-0 leading-relaxed font-sans">{faq.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          )}

          <!-- Location Map Section -->
          <div class="w-full">
            <div class="border-b border-[#e5e5e5] px-[12px] py-[12px]">
              <p class="uppercase font-bold text-black text-lg m-0 font-heading">{pageData.locationTitle || 'OUR LOCATION'}</p>
            </div>
            <div class="block w-full overflow-hidden" style="height: 400px;">
              <img src="https://ghostgunsdotcom.s3.us-east-2.amazonaws.com/wp-content/uploads/2026/01/screenshote-2026-01-07-at-16.5945.%402x-scaled.png"
                   alt="Ghost Guns Location - Austin TX"
                   class="w-full h-full object-cover object-center"
                   loading="lazy" />
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const contactStatus = document.getElementById('contact-status');

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('contact-name') as HTMLInputElement)?.value || '';
    const email = (document.getElementById('contact-email') as HTMLInputElement)?.value || '';
    const subject = (document.getElementById('contact-subject') as HTMLInputElement)?.value || '';
    const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value || '';

    const submitBtn = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const originalBtnText = submitBtn?.textContent || 'Send Message';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'SENDING...';
    }

    try {
      await fetch('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'contact', name, email, subject, message })
      });
    } catch (err) {
      console.error('Contact dispatch error:', err);
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      }
      contactStatus?.classList.remove('hidden');
      contactForm.reset();
    }
  });
</script>
