---
import Layout from '../layouts/Layout.astro';
import { getLocalizedPath, useTranslations, type Locale } from '../utils/i18n';
import { SILO_PILLARS } from '../utils/silo';

interface Props {
  post: any;
  lang?: Locale;
}

const { post, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const cleanDescription = post.excerpt?.rendered
  ? post.excerpt.rendered.replace(/<[^>]*>?/gm, '').trim()
  : '';
---

<Layout
  title={`${post.title.rendered} | Ghost Guns`}
  description={cleanDescription}
  lang={lang}
>
  <div class="max-w-[1440px] mx-auto bg-white shadow-sm">
    <!-- Breadcrumbs -->
    <div class="border-l border-r border-b border-neutral-300 bg-neutral-950 text-white px-4 sm:px-6 py-3 text-xs font-mono uppercase flex items-center gap-2">
      <a href={getLocalizedPath('/', lang)} class="text-neutral-400 hover:text-white">Home</a>
      <span class="text-neutral-600">/</span>
      <a href={getLocalizedPath('/blog/', lang)} class="text-[#ff4d58] hover:underline font-bold">Knowledge Base</a>
      <span class="text-neutral-600">/</span>
      <span class="text-white font-bold truncate max-w-[200px] md:max-w-none">{post.title.rendered}</span>
    </div>

    <!-- Article Header -->
    <header class="border-l border-r border-b border-neutral-300 p-6 sm:p-12 bg-neutral-950 text-white bg-blueprint-grid">
      <div class="max-w-4xl">
        <div class="text-xs font-mono text-[#ff4d58] mb-3 uppercase flex flex-wrap items-center gap-2 font-bold">
          <span>PUBLISHED ON {new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          <span>//</span>
          <span>AUTHOR: CODY WILSON</span>
          <span>//</span>
          <span class="bg-white/10 text-white px-2 py-0.5">TECHNICAL FIELD GUIDE</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-heading font-black uppercase text-white leading-none tracking-tight m-0">
          {post.title.rendered}
        </h1>
      </div>
    </header>

    <!-- Main 2-Column Layout: Article Body + Hardware Silo Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 border-l border-r border-b border-neutral-300">
      <div class="lg:col-span-8 p-6 sm:p-12 border-b lg:border-b-0 lg:border-r border-neutral-300 bg-white">
        <article class="max-w-none prose" set:html={post.content.rendered} />
      </div>

      <!-- Right Sidebar: Direct Silo Links -->
      <aside class="lg:col-span-4 p-6 sm:p-8 bg-neutral-50 flex flex-col gap-6">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#9f0712] font-bold block mb-1">
            HARDWARE SILO DIRECTORY //
          </span>
          <h3 class="text-lg font-heading font-black uppercase text-neutral-950 mb-3">
            Shop Featured Silos
          </h3>
          <div class="flex flex-col gap-2.5">
            {SILO_PILLARS.map((pillar) => (
              <a
                href={getLocalizedPath(pillar.path, lang)}
                class="p-3.5 bg-white hover:bg-neutral-950 text-neutral-950 hover:text-white border border-neutral-300 transition-colors block group"
              >
                <span class="text-[10px] font-mono text-[#9f0712] group-hover:text-[#ff4d58] font-bold block mb-0.5">
                  {pillar.code}
                </span>
                <span class="text-xs font-heading font-black uppercase block">
                  {pillar.defaultTitle} &rarr;
                </span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>

    <!-- Bottom Navigation -->
    <div class="border-l border-r border-b border-neutral-300 p-6 flex flex-wrap justify-between items-center gap-4 bg-neutral-100">
      <a href={getLocalizedPath('/blog/', lang)} class="text-xs font-mono uppercase font-bold text-neutral-950 hover:text-[#9f0712] flex items-center gap-2">
        &larr; Back to Knowledge Base
      </a>
      <a href={getLocalizedPath('/shop/', lang)} class="px-5 py-2.5 bg-[#9f0712] hover:bg-neutral-950 text-white text-xs font-mono uppercase font-bold transition-colors">
        Explore All 76 Platforms &amp; Build Kits &rarr;
      </a>
    </div>
  </div>
</Layout>
